                  "role": "PhysicalVolume",
                  "group": "bench"
                }
              },
              "groups": {
                "workshop": {
                  "extent_bytes": 4194304,
                  "volumes": {
                    "notes": {
                      "extents": [
                        {
                          "pv": "/dev/workshopa",
                          "index": 0
                        },
                        {
                          "pv": "/dev/workshopa",
                          "index": 1
                        }
                      ],
                      "filesystem": {
                        "blocks": 2048,
                        "files": {
                          "/keep.txt": {
                            "contents": "workshop/notes: preserve this record.\n"
                          }
                        }
                      }
                    }
                  }
                },
                "bench": {
                  "extent_bytes": 4194304,
                  "volumes": {
                    "spare": {
                      "extents": [
                        {
                          "pv": "/dev/bencha",
                          "index": 0
                        }
                      ],
                      "filesystem": null
                    }
                  }
                }
              },
              "activation": {
                "active": {
                  "workshop/notes": false,
                  "bench/spare": false
                },
                "open": []
              }
            },
            "targets": [],
            "availability": {
              "groups": [
                {
                  "name": "workshop",
                  "active": true
                }
              ]
            },
            "worked": [
              {
                "text": "lvs",
                "explanation": "The supplied ModelActive column distinguishes existing but inactive storage from available LVs."
              },
              {
                "text": "vgchange -a y workshop",
                "explanation": "Make workshop/notes available. Bench/spare remains deliberately inactive."
              },
              {
                "text": "lvs",
                "explanation": "Confirm notes is active; the retained-file inspection can now read its supplied contents."
              }
            ],
            "try_change": "After the example passes, run vgchange -an workshop and Check separate example. The notes allocation still exists, but its simulated reader is unavailable. Reactivate only workshop with vgchange -ay workshop and check again.",
            "experiment": "vgchange -an workshop",
            "repair": "vgchange -ay workshop"
          }
        }
      },
      "guide": [],
      "steps": [
        "Inspect allocation, availability and supplied consumer facts",
        "Change only the intended group availability",
        "Verify the simulated reader and all requested states",
        "Preserve live data and unrelated availability"
      ],
      "hints": [
        "Existing allocation and filesystem capacity do not prove availability. Inspect ModelActive and the current LV state.",
        "Change availability of the named reports group; do not allocate replacement data or activate reserve.",
        "After activation, use Inspect retained files and exact byte capacities to view the simulated reader. Original contents and every unrelated state must remain."
      ],
      "explanation": "Activation makes existing LVs available; it does not rebuild data, mount a filesystem or set boot policy. A group command applies to all its LVs. The complete current availability plan, original data and unrelated states determine success; terminal text alone does not.",
      "sources": [
        "https://www.lpi.org/our-certifications/exam-201-202-objectives/",
        "https://man7.org/linux/man-pages/man8/vgchange.8.html"
      ],
      "simplifications": "Optional bounded per-LV availability over supplied virtual storage and immutable authored open-consumer facts. One explicit VG per vgchange; y/n only, with disclosed short/long/combined forms. No host/kernel/device-mapper/udev, automatic activation, degraded/missing-PV/partial activation, lvchange, real process/mount discovery, force or boot persistence. Busy deactivation is refused before effects; real LVM can have partial effects. The labeled ModelActive report and application reader are simulator facilities, not exact lvs formatting or a Linux mount. All prior linear/retirement command boundaries still apply.",
      "solution": [
        "lvs",
        "vgchange -ay reports",
        "lvs"
      ],
      "prerequisites": [
        "lpic2-lvm-retire-pool"
      ]
