        "definition": {
          "initial": {
            "id": "lpic1-removable-startup-policy",
            "instructions": "Configure only /project and /media/audit using the supplied intended filesystems. Make /project a required automatic read/write mount, and /media/audit an optional automatic read-only mount. Both correct volumes must mount when available. If only the removable audit medium is absent, required-storage checks must still succeed. If the project filesystem is absent, its required-storage problem must remain visible. Do not hide that failure with nofail or skip the requested automatic mounts with noauto.",
            "starter": "UUID=00000000-0000-4000-8000-000000000090 /project xfs rw,auto,nofail 0 2\nUUID=00000000-0000-4000-8000-000000000091 /media/audit ext4 rw,noauto 0 0\n",
            "cases": [
              {
                "id": "lpic1-removable-startup-policy-case-0",
