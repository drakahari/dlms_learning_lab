                        "filesystem": "ext4"
                      }
                    },
                    "devices": {
                      "/dev/sim-a": "project",
                      "/dev/sim-b": "audit"
                    },
                    "mountpoints": [
                      "/project",
                      "/media/audit"
                    ]
                  },
                  "present": [
                    "project",
                    "audit"
                  ]
                },
                "requirements": [
