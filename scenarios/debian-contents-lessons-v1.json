{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "lpic1-package-file-provider",
      "version": 1,
      "track": "LPIC-1",
      "topic": "Debian package administration",
      "unit": "debian-package-file-search",
      "title": "Find and install the package behind a missing command",
      "summary": "Use repository file listings to distinguish a missing executable from similarly named documentation and private helpers.",
      "objective": "Refresh the supplied package and Contents metadata. Install the package that provides /usr/bin/ledger-check, with intact files and satisfied dependencies. Do not install packages that only supply documentation or a private-path lookalike. Preserve the installed records-viewer and records-lib packages, their files and /work/records-notes.txt.",
      "difficulty": "Beginner",
      "minutes": 20,
      "retry_guidance": "Read the unmet result and correct the relevant package. A query is evidence, not a repair. Destructive changes such as purging required settings can need Reset to restore this lab\u2019s supplied package state; other labs and favorites stay saved.",
      "steps": [
        "Compare installed ownership with available file providers.",
        "Refresh the supplied metadata and investigate exact paths.",
        "Install the required provider and verify preserved software."
      ],
      "guide": [
        {
          "title": "Understand the task",
          "why": "A command file can have a different name from its package. dpkg-query -S checks installed records; apt-file searches the repository Contents index, including packages not installed here.",
          "action": "Start with installed ownership, then search for the missing file.",
          "commands": [
            {
              "command": "dpkg-query -S /usr/bin/ledger-check",
              "explanation": "An absent recorded owner is expected before the provider is installed; it does not prove that no repository package contains the file.",
              "simulator_only": false
            }
          ]
        },
        {
          "title": "Locate the complete path",
          "why": "A name-only match can be documentation or a private helper. Refresh first, then compare complete paths. -F requires the literal complete path in this supported subset; paths are printed without an initial slash.",
          "action": "Use search to gather matches, then inspect the exact executable path and list the identified package.",
          "commands": [
            {
              "command": "apt-get --error-on=any update",
              "explanation": "Refresh this sample\u2019s coherent package and Contents snapshot without installing software.",
              "simulator_only": false
            },
            {
              "command": "apt-file search ledger-check",
              "explanation": "Look for literal substring matches in repository file names, including uninstalled packages.",
              "simulator_only": false
            },
            {
              "command": "apt-file -F search usr/bin/ledger-check",
              "explanation": "Narrow to the complete path; usr/libexec and documentation do not match.",
              "simulator_only": false
            }
          ]
        },
        {
          "title": "Install and verify",
          "why": "Search results describe available files; they do not create those files or install a package.",
          "action": "Install the provider you identified, inspect its record and use Check work.",
          "commands": []
        }
      ],
      "hints": [
        "If the old index shows only documentation and a private helper, refresh metadata before concluding the executable is unavailable.",
        "Compare complete paths: usr/bin/ledger-check is different from usr/libexec/ledger-check and usr/share/doc/ledger-check.",
        "The text before the colon in an apt-file result is the package name. Use that name in apt-get -y install; a query alone leaves the task unfinished."
      ],
      "sources": [
        "https://www.lpi.org/our-certifications/exam-101-102-objectives/",
        "https://manpages.debian.org/trixie/apt/apt-get.8.en.html",
        "https://manpages.debian.org/trixie/dpkg/dpkg-query.1.en.html",
        "https://manpages.debian.org/trixie/dpkg/dpkg.1.en.html",
        "https://manpages.debian.org/trixie/apt-file/apt-file.1.en.html",
        "https://sources.debian.org/src/apt-file/3.3/apt-file/"
      ],
      "simplifications": "Offline script-free Debian package model, not the Fedora host. Only disclosed literal commands and supplied regular text files, packages and publications are supported. No real downloads, archives, maintainer scripts, root permissions, signature checks, rollback guarantee, full dependency resolver, package-manager concurrency, RPM or host execution. Configuration retention follows the declared simplified policy. Sources checked 2026-10-25; LPIC-1 v5.0 102.4 is only partially addressed. Contents queries are a bounded original implementation of the literal apt-file 3.3 search/list subset. Each supplied publication includes coherent Packages/Contents data, derived from its regular-file manifests; independent/missing Contents targets, architecture selectors, regex/glob options, source-list editing and multiple sources are not modeled. Sources rechecked 2026-11-02; no host apt-file comparison is claimed.",
      "initial": {
        "kind": "DebianPackages",
        "simulation": {
          "catalog": {
            "architecture": "amd64",
            "repository_reachable": true,
            "published": "records-current",
            "archives": {
              "records-lib": {
                "name": "records-lib",
                "version": "1.0-1",
                "architecture": "amd64",
                "depends": [],
                "files": {
                  "/usr/lib/records/base.txt": {
                    "contents": "base\n",
                    "conffile": false
                  }
                }
              },
              "records-viewer": {
                "name": "records-viewer",
                "version": "1.0-1",
                "architecture": "amd64",
                "depends": [],
                "files": {
                  "/usr/bin/records-viewer": {
                    "contents": "viewer\n",
                    "conffile": false
                  }
                }
              },
              "records-tool": {
                "name": "records-tools",
                "version": "1.0-1",
                "architecture": "amd64",
                "depends": [
                  {
                    "name": "records-lib",
                    "constraint": null
                  }
                ],
                "files": {
                  "/usr/bin/ledger-check": {
                    "contents": "tool\n",
                    "conffile": false
                  }
                }
              },
              "records-docs": {
                "name": "records-docs",
                "version": "1.0-1",
                "architecture": "amd64",
                "depends": [],
                "files": {
                  "/usr/share/doc/ledger-check": {
                    "contents": "documentation, not executable\n",
                    "conffile": false
                  }
                }
              },
              "records-private": {
                "name": "records-private",
                "version": "1.0-1",
                "architecture": "amd64",
                "depends": [],
                "files": {
                  "/usr/libexec/ledger-check": {
                    "contents": "private helper\n",
                    "conffile": false
                  }
                }
              }
            },
            "publications": {
              "records-old": {
                "candidates": {
                  "records-lib": "records-lib",
                  "records-viewer": "records-viewer",
                  "records-docs": "records-docs",
                  "records-private": "records-private"
                }
              },
              "records-current": {
                "candidates": {
                  "records-lib": "records-lib",
                  "records-viewer": "records-viewer",
                  "records-tools": "records-tool",
                  "records-docs": "records-docs",
                  "records-private": "records-private"
                }
              }
            },
            "extra_paths": [
              "/work/records-notes.txt"
            ]
          },
          "runtime": {
            "cached": "records-old",
            "local_archives": [
              "records-lib",
              "records-viewer"
            ],
            "records": {
              "records-lib": {
                "archive": "records-lib",
                "status": "Installed"
              },
              "records-viewer": {
                "archive": "records-viewer",
                "status": "Installed"
              }
            },
            "files": {
              "/usr/lib/records/base.txt": "base\n",
              "/usr/bin/records-viewer": "viewer\n",
              "/work/records-notes.txt": "keep these local notes\n"
            }
          }
        }
      },
