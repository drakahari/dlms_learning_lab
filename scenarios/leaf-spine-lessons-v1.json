{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "ccna-leaf-spine-rack-expansion",
      "version": 1,
      "track": "CCNA",
      "unit": "ccna-leaf-spine-fabrics",
      "topic": "Leaf/spine architecture",
      "title": "Commission a rack without losing fabric alternatives",
      "summary": "Connect a new rack to a leaf/spine fabric, then investigate independent spine paths during failures.",
      "objective": "Commission Rack 4 by completing its three supplied cables. Connect every leaf to three different spines; use each port at most once and preserve all nine existing rack cables. Keep three distinct internal spine alternatives from each existing rack to Rack 4 with all devices available, and at least two after each stated single-spine loss. A parallel cable to one spine does not count as another spine.",
      "difficulty": "Intermediate",
      "minutes": 25,
      "steps": [
        "Understand leaf/spine fan-out",
        "Commission separate guide equipment",
        "Add a rack and verify every stated failure"
      ],
      "hints": [
        "Compare the new leaf’s three connections with the protected racks. Count different spine devices, not cables.",
        "Each spine needs an unused port for the new rack. Inspect the fixed-cable list before choosing endpoints.",
        "In the selected case, inspect each rack pair. A normal working path alone is insufficient; the number of remaining internal spines matters."
      ],
      "sources": [
        "https://learningcontent.cisco.com/documents/marketing/exam-topics/200-301-CCNA-v1.1.pdf",
        "https://www.cisco.com/c/en/us/td/docs/switches/datacenter/nexus3400s/sw/93x/fundamentals/configuration/guide/cisco-n3400s-nx-os-fundamentals-configuration-guide-933/cisco-n3400-nx-os-fundamentals-configuration-guide-9z_chapter_010.pdf",
        "https://www.cisco.com/c/en/us/td/docs/dcn/whitepapers/cisco-application-centric-infrastructure-design-guide.html"
      ],
      "simplifications": "Sources checked 2026-11-13: current CCNA v1.1 objective 1.2c; Cisco Nexus 3400 fundamentals 9.3(3), overview; Cisco ACI design guide (updated 2024-06-06), physical topology. This exercise is a conventional two-tier leaf/spine shape with already-configured routed adjacencies, one per device pair. No actual packets, routing protocols, ECMP hashing, EVPN/VXLAN, ACI controller, LAG, performance or convergence are modeled. Two cables is a structural hop count, not a latency guarantee. Modern designs can have other tiers and arrangements; this is not a universal prohibition.",
      "explanation": "Each rack leaf joins every supplied spine. For any two rack leaves, each shared available spine gives a separate two-cable path. Three shared spines give three internal alternatives; removing one leaves two. The new rack must preserve the existing racks’ connections. The grade checks actual cable roles, distinct parents and every required pair under each stated outage, accepting equivalent unused ports.",
