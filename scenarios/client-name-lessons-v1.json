    {
      "id": "lpic1-local-host-alias",
      "version": 1,
      "track": "LPIC-1",
      "topic": "Local names and aliases",
      "unit": "linux-client-name-sources",
      "title": "Repair a local host name and retire its old alias",
      "summary": "Repair local address-book records and inspect real simulated source/status/action traces.",
      "objective": "Give dispatch.office.lab.test and the short alias dispatch the supplied local address 192.0.2.55. Remove the retired alias old-dispatch. Preserve localhost at 127.0.0.1 and printer.office.lab.test at 192.0.2.60. Prove these local answers work with DNS available and unavailable.",
      "difficulty": "Beginner",
      "minutes": 18,
      "prerequisites": [
        "lpic1-host-resolver"
      ],
      "steps": [
        "Edit the virtual files, run the supplied lookups and inspect each source trace before retrying."
      ],
      "guide": [],
      "hints": [
        "A row can resolve successfully to an outdated address. Compare the actual address, not just SUCCESS.",
        "The short alias belongs after the main name on the same row; keep each name unique.",
        "Preserve the peer and localhost rows. Remove only the retired alias from the dispatch row."
      ],
      "explanation": "The supplied dispatch address belongs at the beginning of its hosts row. Keeping dispatch.office.lab.test and dispatch on that row provides both names; removing old-dispatch retires only that alias. The existing localhost and printer records remain. A successful files lookup returns before DNS, so these local answers remain available in the outage sample. Supported formatting/comments and an equivalent unambiguous ordering of rows also work.",
      "sources": [
        "https://www.lpi.org/our-certifications/exam-101-102-objectives/",
        "https://sourceware.org/glibc/manual/latest/html_node/Actions-in-the-NSS-configuration.html",
        "https://man7.org/linux/man-pages/man5/hosts.5.html"
      ],
      "simplifications": "In-process IPv4 name-source simulation: editable hosts and hosts-only nsswitch.conf excerpt, files/dns sources, finite supplied DNS A/status snapshots and explicit source/status/action traces. At most16KiB/128lines per file,64host rows/128names/eight names per row,64DNS records, four samples/twelve lookups each. Default actions and explicit NOTFOUND/UNAVAIL/TRYAGAIN return/continue plus SUCCESS=return only. Other NSS modules/databases, SUCCESS=continue, negation/merge, ambiguous duplicate host names, real OS files/modules/resolvers, DNS packets/server routing, search/ndots, multiple A/IPv6/reverse/CNAME/cache and systemd-resolved are outside this subset. No host operation. Full109.4 remains incomplete.",
      "initial": {
        "kind": "ClientNames",
        "simulation": {
          "version": 1,
          "origin": "lpic1-local-host-alias",
          "view": "introduction",
          "assignment": {
            "draft": {
              "hosts": "127.0.0.1 localhost\n192.0.2.9 dispatch.office.lab.test old-dispatch\n192.0.2.60 printer.office.lab.test\n",
              "nsswitch.conf": "hosts: files dns\n"
            },
            "tested": null,
            "selected": "hosts"
          },
          "practice": {
            "draft": {
              "hosts": "127.0.0.1 localhost\n192.0.2.9 studio.workshop.lab.test old-studio\n198.51.100.40 camera.workshop.lab.test\n",
              "nsswitch.conf": "hosts: files dns\n"
            },
            "tested": null,
            "selected": "hosts"
          }
        }
      },
      "goal": {
        "kind": "ClientNames",
        "definition": {
          "initial": {
            "id": "lpic1-local-host-alias",
            "instructions": "Give dispatch.office.lab.test and the short alias dispatch the supplied local address 192.0.2.55. Remove the retired alias old-dispatch. Preserve localhost at 127.0.0.1 and printer.office.lab.test at 192.0.2.60. Prove these local answers work with DNS available and unavailable.",
            "starter": {
              "hosts": "127.0.0.1 localhost\n192.0.2.9 dispatch.office.lab.test old-dispatch\n192.0.2.60 printer.office.lab.test\n",
              "nsswitch.conf": "hosts: files dns\n"
            },
            "cases": [
              {
                "id": "dns-available",
                "label": "DNS available: local records still take precedence",
                "context": {
                  "files_available": true,
                  "dns": {
                    "status": "Success",
                    "records": {
                      "dispatch.office.lab.test": "192.0.2.200"
