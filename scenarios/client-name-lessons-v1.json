    {
      "id": "lpic1-name-source-fallback",
      "version": 1,
      "track": "LPIC-1",
      "topic": "Name-source order and fallback",
      "unit": "linux-client-name-sources",
      "title": "Keep local overrides while allowing DNS fallback",
      "summary": "Diagnose competing name sources and preserve useful fallback across four supplied availability snapshots.",
      "objective": "Prefer the local override rescue.office.lab.test and alias rescue at 192.0.2.55; preserve printer.office.lab.test at 192.0.2.60. Resolve catalog.office.lab.test through the supplied DNS snapshot, not a copied local address. Let a missing local name continue to DNS. Keep the override working during a DNS outage. If the local table is unavailable, use the supplied DNS backup for the override and report the peer honestly as unresolved.",
      "difficulty": "Intermediate",
      "minutes": 25,
      "prerequisites": [
        "lpic1-local-host-alias"
      ],
      "steps": [
        "Edit the virtual files, run the supplied lookups and inspect each source trace before retrying."
      ],
      "guide": [],
      "hints": [
        "Read the source trace for a failed catalog lookup: did it actually reach dns?",
        "Bracket actions belong to the preceding source. Returning on a miss can stop fallback.",
        "A local answer normally stops the search. Keep files before dns for the requested override and preserve default continuation on missing/unavailable sources."
      ],
      "explanation": "files before dns retains the deliberate local rescue override. The default NOTFOUND and UNAVAIL actions continue, so changing catalog records can come from DNS and the supplied DNS backup can be used when the local table is unavailable. A DNS outage does not erase local records. Explicit equivalent default rules are accepted; static catalog copies fail when the DNS sample changes. This finite trace is not a live DNS or glibc conformance test.",
      "sources": [
        "https://www.lpi.org/our-certifications/exam-101-102-objectives/",
        "https://sourceware.org/glibc/manual/latest/html_node/Actions-in-the-NSS-configuration.html",
        "https://man7.org/linux/man-pages/man5/hosts.5.html"
      ],
      "simplifications": "In-process IPv4 name-source simulation: editable hosts and hosts-only nsswitch.conf excerpt, files/dns sources, finite supplied DNS A/status snapshots and explicit source/status/action traces. At most16KiB/128lines per file,64host rows/128names/eight names per row,64DNS records, four samples/twelve lookups each. Default actions and explicit NOTFOUND/UNAVAIL/TRYAGAIN return/continue plus SUCCESS=return only. Other NSS modules/databases, SUCCESS=continue, negation/merge, ambiguous duplicate host names, real OS files/modules/resolvers, DNS packets/server routing, search/ndots, multiple A/IPv6/reverse/CNAME/cache and systemd-resolved are outside this subset. No host operation. Full109.4 remains incomplete.",
      "initial": {
        "kind": "ClientNames",
        "simulation": {
          "version": 1,
          "origin": "lpic1-name-source-fallback",
          "view": "introduction",
          "assignment": {
            "draft": {
              "hosts": "127.0.0.1 localhost\n192.0.2.55 rescue.office.lab.test rescue\n192.0.2.60 printer.office.lab.test\n",
              "nsswitch.conf": "hosts: dns [NOTFOUND=return UNAVAIL=return] files\n"
            },
            "tested": null,
            "selected": "hosts"
          },
          "practice": {
