    {
      "id": "lpic1-links-identity",
      "version": 1,
      "track": "LPIC-1",
      "topic": "Hard and symbolic links",
      "unit": "linux-link-handover",
      "title": "Choose a shared name and an independent snapshot",
      "summary": "Distinguish a shared file from a copy by inspecting identity and future edits.",
      "objective": "Use /delivery/live as a hard-link name for /work/report. Create an independent copy at /archive/snapshot. Retain Release notes v1 plus a newline in both files and preserve /work/keep. Future edits through either live name must affect both; the snapshot must remain independent.",
      "difficulty": "Beginner",
      "minutes": 12,
      "steps": [
        "Investigate the supplied files and links, make the required changes, then check the whole result."
      ],
      "guide": [],
      "explanation": "Inspect inode IDs and symbolic-link text first. Use the supported link/copy/move operations for the required relationship, verify contents, and retain protected data. See the worked practice files for a different example.",
      "hints": [
        "Use stat to compare regular-file inode IDs; a symbolic link has a different inode from its target.",
        "A relative symbolic target starts in the directory containing the link. Use stat -L to follow it.",
        "Retained shared names need the original inode; an independent snapshot needs another regular inode."
      ],
      "sources": [
        "https://www.lpi.org/our-certifications/exam-101-102-objectives/",
        "https://man7.org/linux/man-pages/man7/symlink.7.html"
      ],
      "simplifications": "One bounded virtual device with fixed directories and cwd. No permissions, mount boundaries, open descriptors, directory mutation, overwriting destinations or full GNU utilities. Native file editor changes simulated existing files only. Commands never reach a host shell.",
      "initial": {
        "kind": "Links",
        "simulation": {
          "version": 1,
