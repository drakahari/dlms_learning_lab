              }
            },
            "targets": [],
            "retirement": {
              "retired_volumes": [
                "workshop/trial",
                "workshop/buffer"
              ],
              "retired_groups": [],
              "cleared_pvs": []
            },
            "worked": [
              {
                "text": "lvs",
                "explanation": "Locate trial and buffer, the two declared unused raw allocations; ledger is protected."
              },
              {
                "text": "vgs",
                "explanation": "Read the five extents currently free in workshop."
              },
              {
                "text": "lvremove -y workshop/trial",
                "explanation": "Remove only trial; its one extent returns to workshop."
              },
              {
                "text": "lvremove --yes /dev/workshop/buffer",
                "explanation": "Remove buffer; two more extents return to the same pool."
              },
              {
                "text": "lvs",
                "explanation": "Only the protected ledger should remain in workshop."
              },
              {
                "text": "vgs",
                "explanation": "The pool now has eight free extents; the device is the same size."
              }
            ],
            "try_change": "After the example passes, allocate trial again with lvcreate -l 1 -n trial workshop. Check the still-present name and lower free count, then retire it again with lvremove -y workshop/trial and check.",
            "experiment": "lvcreate -l 1 -n trial workshop",
            "repair": "lvremove -y workshop/trial"
          }
        }
      },
      "guide": [],
      "steps": [
        "Inspect supplied ownership and protected data",
        "Retire only the requested unused objects",
        "Verify returned extents or cleared labels",
        "Confirm every unrelated object remains unchanged"
      ],
      "hints": [
        "Inspect the existing names in lvs. Raw means no modeled filesystem, not automatically safe to remove on real equipment.",
        "Remove each named unused raw LV; changing or extending ledger cannot return its neighbors\u2019 extents.",
        "Use vgs to compare the returned free pool. The group and all unrelated storage must remain."
      ],
      "explanation": "Raw LV removal returns physical extents to its pool. Empty-group removal releases ownership but keeps PV labels. PV-label removal is a separate operation; it does not erase every byte or format a filesystem. The complete current plan and protected data determine success.",
      "sources": [
        "https://www.lpi.org/our-certifications/exam-201-202-objectives/",
        "https://man7.org/linux/man-pages/man8/lvremove.8.html",
        "https://man7.org/linux/man-pages/man8/vgremove.8.html",
        "https://man7.org/linux/man-pages/man8/pvremove.8.html",
        "https://man7.org/linux/man-pages/man8/pvs.8.html"
      ],
      "simplifications": "Source-enabled bounded raw LVM lifecycle on supplied virtual devices only. No host device or command, filesystem-bearing removal, real activation/mount/process-use proof, force, vgreduce, secure erasure, snapshots, thin/RAID, rename, reduction or lvm.conf. Whole extents, fixed 1 MiB data start and fixed byte-column reports. Modeled operations publish one validated candidate; real LVM does not promise multi-device rollback. Empty-group/unowned-PV refusal is a subset boundary, not real-system protection.",
      "solution": [
        "lvs",
        "lvremove -y records/scratch",
        "lvremove -y records/cache",
        "vgs",
        "lvs"
      ],
      "prerequisites": [
        "lpic2-lvm-provision-handover"
      ]
