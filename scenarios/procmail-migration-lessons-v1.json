            "starter": "# Replace the legacy delivery policy with Sieve.\nkeep;\n",
            "reference": "require \"fileinto\";\nif header :is \"X-Team\" \"operations\" {\n    fileinto \"Archive\";\n}\nif header :is \"X-Priority\" \"urgent\" {\n    fileinto \"Urgent\";\n    stop;\n}\nkeep;\n",
