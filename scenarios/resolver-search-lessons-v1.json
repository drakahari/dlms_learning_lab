    {
      "id": "lpic1-dns-search-suffixes",
      "version": 1,
      "track": "LPIC-1",
      "unit": "linux-resolver-search",
      "topic": "DNS search suffixes",
      "title": "Repair a DNS search path without choosing the wrong site",
      "summary": "Edit a resolver excerpt and inspect the actual candidate sequence against supplied DNS snapshots.",
      "objective": "Resolve report through north.office.lab.test, even though south.office.lab.test also has that name. Let assets fall through to its supplied answer in south.office.lab.test. Preserve the absolute peer lookup (peer.office.lab.test.) and leave the supplied missing name unresolved. Apply the same search policy to both DNS snapshots; the sample hostname alone supplies the wrong default site.",
      "difficulty": "Beginner",
      "minutes": 20,
      "prerequisites": [
        "lpic1-name-source-fallback"
      ],
      "steps": [
        "Inspect the supplied DNS records, edit the virtual search settings and verify every required lookup."
      ],
      "guide": [],
      "hints": [
        "Read the candidate that produced the wrong answer; SUCCESS alone does not identify the intended site.",
        "Keep both requested sites on one search line. A later search line replaces the earlier list.",
        "The report site must be first, but assets still needs the second site after a definite miss."
      ],
      "explanation": "The ordered north/south search list makes report stop at the intended north record while assets falls through to its south record. Both supplied snapshots follow the same policy despite a changed A value. The final dot on the peer/missing queries prevents suffixes. Comments, uppercase/trailing-dot suffix spellings and equivalent supported ndots settings can work; an incomplete or reversed site list cannot satisfy all lookups.",
      "sources": [
        "https://www.lpi.org/our-certifications/exam-101-102-objectives/",
        "https://man7.org/linux/man-pages/man5/resolv.conf.5.html",
        "https://sourceware.org/glibc/manual/latest/html_node/index.html"
      ],
      "simplifications": "Pure in-process search/domain/options-ndots excerpt only. DNS snapshots provide one IPv4 A answer or a definite missing name; no actual queries. The supplied hostname, not the desktop, determines the default domain. At most16KiB/128lines, three suffixes/four candidate names, ordinary ASCII labels and253-byte expanded names, ndots0–15, explicit root suffix, final-dot absolute names and first-positive stopping. Whole-line comments only. No nameserver routing, other options, unavailable/retry sequencing, HOSTALIASES/environment/other resolver flags, cache, CNAME, IPv6/multiple answers, DNSSEC, packets, timing, files, sockets or OS resolver calls. This is not actual glibc conformance or full109.4 coverage.",
      "initial": {
        "kind": "ClientNames",
        "simulation": {
          "version": 1,
          "origin": "lpic1-dns-search-suffixes",
          "view": "introduction",
          "assignment": {
            "draft": {
              "resolv.conf": "search south.office.lab.test north.office.lab.test\n"
            },
            "tested": null,
            "selected": "resolv.conf"
          },
