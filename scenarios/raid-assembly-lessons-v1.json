              "operation": {
                "kind": "command",
                "text": "mdadm --examine /dev/vda1"
              },
              "explanation": "Read the existing reporting member identity; this does not change metadata.",
              "status": 0
            },
            {
              "operation": {
                "kind": "command",
                "text": "mdadm --examine /dev/vdb1"
              },
              "explanation": "Confirm that the second member has the same complete UUID and the other active role.",
              "status": 0
            },
            {
              "operation": {
                "kind": "command",
                "text": "mdadm --assemble --scan /dev/md10"
              },
              "explanation": "Observe the broken saved policy before repairing it. Command failure is useful evidence.",
              "status": 1
            },
            {
              "operation": {
                "kind": "save",
                "text": "DEVICE /dev/vda1 /dev/vdb1 /dev/vdc1 /dev/vdd1\nARRAY /dev/md10 UUID=73112222:33445566:778899aa:bbccddee\nARRAY /dev/md11 UUID=84553322:1100ffee:ddccbbaa:99887766\n"
              },
              "explanation": "Keep the audit row and all four supplied component paths. Bind the reporting target to the UUID actually read from its two members.",
              "status": 0
            },
            {
              "operation": {
                "kind": "command",
                "text": "mdadm --assemble --scan /dev/md10"
              },
              "explanation": "Assemble the existing complete pair from the saved row; this creates no new data or metadata.",
              "status": 0
            },
            {
              "operation": {
                "kind": "command",
                "text": "cat /proc/mdstat"
              },
              "explanation": "Both arrays should be active with two in-sync members, shown as [2/2] [UU].",
              "status": 0
            },
            {
              "operation": {
                "kind": "command",
                "text": "mdadm --detail /dev/md10"
              },
              "explanation": "Confirm the reporting UUID at the intended active target; success status alone is insufficient.",
              "status": 0
            }
          ],
