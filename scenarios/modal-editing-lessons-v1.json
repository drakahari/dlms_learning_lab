      "explanation": "The accidental draft and saved handover are different data. Discarding with :q! or undoing the unsaved change preserves the file; writing the bad draft would not. The separate worker repair must be written. Checking validates all saved requirements and every unsaved buffer, not just the file currently on screen.",
      "goal": {
        "definition": {
          "example": {
            "files": {
              "/lab/handover.txt": {
                "draft": "This unsaved example draft should be discarded.\n",
                "text": "Preserve this original example handover.\n",
                "writable": false
              },
              "/lab/worker.conf": {
                "draft": null,
                "text": "name=demo-c\nport=5000\nworkers=1\n",
                "writable": true
              }
            },
            "requirements": [
              {
                "kind": "Settings",
                "path": "/lab/worker.conf",
                "values": {
                  "port": "5050",
                  "workers": "5"
                }
              },
              {
                "kind": "Unchanged",
                "path": "/lab/handover.txt"
              }
            ],
