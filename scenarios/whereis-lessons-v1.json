  "scenarios": [
    {
      "id": "lpic1-whereis-support-handover",
      "version": 1,
      "track": "LPIC-1",
      "unit": "linux-application-support-discovery",
      "topic": "Application discovery with whereis",
      "title": "Repair an application’s manual and source handover",
      "summary": "Find separate application artifacts, publish the approved manual/source release and preserve neighboring tools.",
      "objective": "reportctl already has a working binary in /apps/bin. Read /apps/stage/release.txt and inspect the separate binary, manual and source search folders. Publish the approved staged manual as /apps/man/reportctl.1 and source as /apps/source/reportctl.c. Remove only /apps/man/reportctl-old.1. Verify all three category paths AND current file contents. Preserve the binary, audit tool, archive, stage, folders, private notes, permissions and supplied settings. Optional scratch /work/support.tmp must be absent at handover.",
      "difficulty": "Intermediate",
      "minutes": 20,
      "steps": [
        "Understand the task",
        "Locate and inspect each artifact",
        "Publish and verify the handover"
      ],
      "guide": [
        {
          "title": "Separate discovery from correctness",
          "why": "A working executable says nothing about its manual or source release.",
          "action": "Use the three supplied whereis forms, then read the release note and current/staged artifacts with cat.",
          "commands": []
        },
        {
          "title": "Make a narrow file handover",
          "why": "An archived file can have the right name and wrong content.",
          "action": "Copy approved staged support files to their named destinations; remove only the explicitly retired manual.",
          "commands": []
        },
        {
          "title": "Verify names and contents",
          "why": "whereis reports locations, not version compatibility.",
          "action": "Repeat category queries, inspect published files and choose Check work. Keep all protected files and remove any scratch file.",
          "commands": []
        }
      ],
      "explanation": "The binary was already eligible in the fixed PATH. whereis searches distinct categories by name: the manual lacked the exact reportctl.1 name, while the source path existed but held release 1. The release note authorizes release 4, so copying both staged support files fixes their contents; removing only the retired manual completes the handover. A location alone does not prove version, permissions or content. The complete-state check also preserves the binary, audit files, archive, stage, notes and settings.",
      "hints": [
        "Use whereis -b -B /apps/bin -f reportctl, then -m -M /apps/man and -s -S /apps/source with the same -f reportctl ending. What does a bare reportctl: line tell you?",
        "Read /apps/stage/release.txt. Compare the staged files with the published source; the archive is an older release. A found source pathname can still hold obsolete text.",
        "Use the existing cp and rm commands for only the named support files. Query again and cat the published manual/source; preserve all neighboring metadata and bytes."
      ],
      "sources": [
        "https://www.lpi.org/our-certifications/exam-101-102-objectives/ (LPIC-1 5.0, 104.7; checked 2026-11-05)",
        "https://mirrors.edge.kernel.org/pub/linux/utils/util-linux/v2.41/util-linux-2.41.5.tar.xz (official whereis source/manual; checked 2026-11-05)",
        "https://www.gnu.org/software/coreutils/manual/html_node/cp-invocation.html (existing bounded ordinary-file copying; web fetch unavailable 2026-11-05)"
      ],
      "simplifications": "In-process virtual files only; no artifact is executed. whereis supports one supplied dot-free name/category/directory at a time: -b -B DIR -f NAME, -m -M DIR -f NAME, -s -S DIR -f NAME. Only NAME, NAME.1 and NAME.c are admitted; significant other suffixes/compression/multiple matches refuse honestly. No default host search, environment search, links, package database, man renderer, compilation or actual binary validation. A normal missing query prints NAME: and status 0. which/type query only supplied fixed PATH. Only four named ordinary-file slots can change; generic literal filesystem subset remains documented. All data and resource limits remain local.",
