{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "lpic1-file-index-handover",
      "version": 1,
      "track": "LPIC-1",
      "unit": "linux-indexed-file-discovery",
      "topic": "Private indexed file discovery",
      "title": "Repair a stale file index and prepare a current handover",
      "summary": "Compare saved filename searches with live files, repair exclusions, rebuild a private index and copy the current document.",
      "objective": "The support index names an old runbook, and a recent configuration edit also hides the current branch. Repair the private index and prepare /work/handover.txt from the current runbook. Save exclusions that omit only /srv/intake/archive; keep current, archives and source searchable. Explicitly rebuild /indexes/intake.db from /srv/intake using /work/index.conf, so its saved names match the live files. Copy the current runbook to /work/handover.txt, retaining normal supplied file permissions and ownership. Preserve every other file, folder, permission and supplied setting.",
      "retry_guidance": "Compare the feedback for saved exclusions, index freshness and handover contents; each can be correct while another still needs repair.",
      "difficulty": "Intermediate",
      "minutes": 25,
      "steps": [
        "Understand the task",
        "Investigate the saved names and exclusions",
        "Refresh and verify the handover"
      ],
      "guide": [],
      "explanation": "Compare locate -d /indexes/intake.db runbook with find /srv/intake -name \"runbook*.txt\". Read both current and archive documents. In /work/index.conf, keep only /srv/intake/archive in PRUNEPATHS, then Save configuration. Run updatedb -l 0 -o /indexes/intake.db -U /srv/intake --config-file /work/index.conf. Repeat locate, copy /srv/intake/current/runbook.txt to /work/handover.txt and inspect it. Saving configuration alone does not rebuild the index; locate -e only checks existence.",
      "hints": [
        "Compare locate with live find. Which returned name no longer exists, and where does the current runbook actually live?",
        "The saved PRUNEPATHS list must keep archive excluded while allowing current. The separate archives folder must remain searchable.",
        "Save configuration, explicitly rebuild with the supplied private paths, then compare the current file and handover contents. A correct copy alone does not prove the index was repaired."
      ],
      "sources": [
        "https://www.lpi.org/our-certifications/exam-101-102-objectives/ (LPIC-1 5.0, 104.7; checked 2026-11-05)",
        "https://plocate.sesse.net/plocate.1.html (locate -d/-e; checked 2026-11-05)",
        "https://plocate.sesse.net/updatedb.8.html (private -l 0, -U, -o, --config-file; checked 2026-11-05)",
        "https://plocate.sesse.net/download/plocate-1.1.25.tar.gz (read-only behavior reference; installed1.1.25 manuals and fixed comparison are recorded in docs/FILE_INDEX_SUBSET.md; no upstream code imported)"
      ],
      "simplifications": "One bounded private -l 0 index over supplied readable/searchable ordinary directories; literal case-sensitive substring queries only. The opaque typed database is shown separately, not as real plocate binary bytes. No global database, privileged visibility rules, incomplete scan publication, timers, mounts, links, arbitrary flags, shell expansion, host filesystem or utility execution. find/cat/cp/rm/chmod operate only on the virtual tree, with a narrow preservation policy. No claim that final-state grading proves a particular investigation command was used.",
      "initial": {
