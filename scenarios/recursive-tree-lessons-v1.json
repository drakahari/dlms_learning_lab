      "version": 1,
      "track": "LPIC-1",
      "unit": "linux-recursive-handovers",
      "topic": "Recursive directory handovers",
      "title": "Repair a handover before retiring its source",
      "summary": "Find missing hidden and nested content, repair the copy, then retire precisely.",
      "objective": "Complete /work/handover with every supplied entry and exact file content, including nested files, hidden names and empty directories. Retain the source permission bits on the handover; transferred entries belong to alex, primary group staff. Verify the handover before removing /work/old-project completely. Keep /work/old-project-current, /work/keep.txt and every unrelated entry unchanged; leave no scratch copies.",
      "retry_guidance": "Inspect the failing outcome, repair the working files, then check again. Reset restores only this attempt if you need the supplied source back.",
      "difficulty": "Intermediate",
      "minutes": 20,
      "steps": [
        "Understand the task",
        "Investigate and repair",
        "Verify the complete handover"
      ],
      "guide": [
        {
          "title": "Compare the whole tree",
          "why": "A handover can look complete at the top level while losing a hidden index or a nested runbook. find visits nested files; ls -la includes names beginning with a dot. Empty directories also belong to the tree.",
          "action": "Run both find commands. Compare nested and hidden names, not only the directory labels.",
          "commands": [
            {
              "command": "find /practice/ready-notes -type f",
              "explanation": "Compare the surviving names.",
              "simulator_only": false
            },
            {
              "command": "find /practice/retired-notes -type f",
              "explanation": "Compare the surviving names.",
              "simulator_only": false
            }
          ]
        },
        {
          "title": "Repair before retiring",
          "why": "Copy the missing files while the original still exists. Ordinary cp preserves file content, filters source permission bits through the creation mask and makes a newly created file yours. Check contents and permissions before deleting the source.",
          "action": "Copy the two missing entries into the practice handover. Inspect their contents before removing anything.",
          "commands": [
            {
              "command": "cp /practice/retired-notes/.index /practice/ready-notes/.index",
              "explanation": "Copy the named practice files or complete directory.",
              "simulator_only": false
            },
            {
              "command": "cp /practice/retired-notes/docs/runbook.txt /practice/ready-notes/docs/runbook.txt",
              "explanation": "Copy the named practice files or complete directory.",
              "simulator_only": false
            }
          ]
        },
        {
          "title": "Verify what remains",
          "why": "rm -r removes a directory and all names below it, including hidden names. It is not a backup or an undo command. The supplied similarly named current project must remain. Real rm can prompt or leave partial work on failure; this simulated subset is noninteractive and refuses atomically.",
          "action": "Retire only the old practice directory, then inspect the surviving handover and check the example.",
          "commands": [
            {
              "command": "rm -r /practice/retired-notes",
              "explanation": "Remove only this old practice tree after verifying its copy.",
              "simulator_only": false
            },
            {
              "command": "find /practice/ready-notes -type f",
              "explanation": "Compare the surviving names.",
              "simulator_only": false
            }
          ]
        }
      ],
      "explanation": "A handover can look complete at the top level while losing a hidden index or a nested runbook. find visits nested files; ls -la includes names beginning with a dot. Empty directories also belong to the tree. Copy the missing files while the original still exists. Ordinary cp preserves file content, filters source permission bits through the creation mask and makes a newly created file yours. Check contents and permissions before deleting the source. rm -r removes a directory and all names below it, including hidden names. It is not a backup or an undo command. The supplied similarly named current project must remain. Real rm can prompt or leave partial work on failure; this simulated subset is noninteractive and refuses atomically.",
