        "kind": "Iscsi",
        "simulation": {
          "assignment": {
            "source": "{\"inventory\":{\"exports\":[{\"key\":{\"target\":\"iqn.2025-03.example.storage:archive-test\",\"portal\":{\"address\":\"203.0.113.19\",\"port\":3261}},\"discovery\":{\"address\":\"203.0.113.17\",\"port\":3260},\"group\":1,\"login_available\":true,\"devices\":[{\"lun\":0,\"name\":\"sdb\",\"wwn\":\"0x5000000000000533\"}]},{\"key\":{\"target\":\"iqn.2025-03.example.storage:archive\",\"portal\":{\"address\":\"203.0.113.19\",\"port\":3261}},\"discovery\":{\"address\":\"203.0.113.17\",\"port\":3260},\"group\":2,\"login_available\":true,\"devices\":[{\"lun\":0,\"name\":\"sdc\",\"wwn\":\"0x5000000000000531\"}]}]},\"initial\":{\"nodes\":[],\"active\":[],\"next_id\":1},\"goal\":{\"target\":{\"target\":\"iqn.2025-03.example.storage:archive\",\"portal\":{\"address\":\"203.0.113.19\",\"port\":3261}},\"lun\":0,\"wwn\":\"0x5000000000000531\",\"automatic_at_startup\":false}}",
