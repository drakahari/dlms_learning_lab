      "solution": [
        "iscsiadm -m discoverydb -t sendtargets -p 203.0.113.17:3260 --discover",
        "iscsiadm -m node",
        "iscsiadm -m node -T iqn.2025-03.example.storage:archive -p 203.0.113.19:3261 --login",
        "iscsiadm -m session -P 3",
        "lsblk -o NAME,WWN",
        "iscsi-workspace check"
