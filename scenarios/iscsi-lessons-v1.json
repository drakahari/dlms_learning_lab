    {
      "id": "lpic2-iscsi-target-identity",
      "version": 1,
      "track": "LPIC-2",
      "unit": "linux-iscsi-initiator",
      "topic": "Network storage: iSCSI",
      "title": "Connect to the iSCSI target that exposes the intended disk",
      "summary": "Discover the virtual storage and connect to the export named in the inventory ticket.",
      "objective": "Save a node record for the supplied target and portal. Connect to that export and verify the supplied LUN and disk WWN. Leave unintended sessions disconnected.",
      "retry_guidance": "Read the failed requirement. Compare the saved record with the active session, and inspect the device identity or startup preview before checking again.",
      "difficulty": "Intermediate",
      "minutes": 17,
      "steps": [
        "Understand the task",
        "Try the separate example",
        "Complete the independent assignment"
      ],
      "guide": [
        {
          "title": "Understand the task",
          "why": "The target name identifies a storage service. The portal is the address and port for connecting to it. The SendTargets request returns the advertised pairs. A portal may host several targets, and a target may be reachable through more than one portal. Use both parts of the pair shown in your ticket.",
          "action": "Read the stored configuration and active-session examples.",
          "commands": []
        },
        {
          "title": "Investigate with separate inputs",
          "why": "A directory result and a saved record do not prove a working connection.",
          "action": "Use the guided console commands and compare output to the inventory ticket.",
          "commands": []
        },
        {
          "title": "Complete the independent assignment",
          "why": "Check the current session and any requested saved policy separately.",
          "action": "Select Check configuration after investigating and making your changes.",
          "commands": []
        }
      ],
      "explanation": "The saved record describes the target and portal. The active session exposes the required LUN, and its disk's WWN matches the inventory ticket. A shared portal or LUN number alone would not pick the correct disk.",
      "hints": [
        "Start with the discovery address in the task details. Compare the full target and portal in the returned rows.",
        "The comma and number after the portal in the listing identify a portal group. For -p, enter only the address and port.",
        "If the expected LUN number appears on a different export, compare the WWN and check which session owns that disk."
      ],
      "sources": [
        "https://www.lpi.org/our-certifications/exam-201-202-objectives/",
        "https://www.rfc-editor.org/rfc/rfc7143.html",
        "https://github.com/open-iscsi/open-iscsi/blob/master/README",
        "https://github.com/open-iscsi/open-iscsi/blob/master/etc/iscsid.conf",
        "https://man7.org/linux/man-pages/man8/lsblk.8.html"
      ],
      "simplifications": "Supplied IPv4 SendTargets responses, saved records, one interface, current sessions, manual/automatic startup and read-only virtual disk facts. No network I/O, daemon/service control, block operations, real boots, CHAP, device probing, multipath, other storage protocols or ordinary shell syntax.",
      "prerequisites": [
        "lpic2-mount-identity"
      ],
