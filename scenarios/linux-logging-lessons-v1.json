    {
      "id": "lpic1-syslog-threshold",
      "version": 1,
      "track": "LPIC-1",
      "topic": "Syslog routing",
      "unit": "linux-syslog-routing",
      "title": "Keep warnings and urgent events, without routine noise",
      "summary": "Configure a severity threshold and check both included and excluded events.",
      "objective": "Route every facility at warning(4) or more urgent levels0\u20133 exactly once to /var/log/operations.log. Do not deliver notice, info or debug events, and do not use other destinations.",
      "difficulty": "Beginner",
      "minutes": 15,
      "steps": [
        "Edit the supplied configuration, run the routing test, inspect specific failures and retry."
      ],
      "guide": [],
      "explanation": "Each matching selector line independently delivers one copy. Compare required and actual routes, repair the smallest selector mistake, then rerun the whole routing policy. The test covers every source/severity combination, not only the displayed events.",
      "hints": [
        "The policy says warning or more urgent, rather than warning only.",
        "A plain severity includes levels with smaller numbers. * before the dot means every facility."
      ],
      "sources": [
        "https://www.lpi.org/our-certifications/exam-101-102-objectives/",
        "https://docs.rsyslog.com/doc/configuration/filters.html",
        "https://www.rfc-editor.org/rfc/rfc5424.html"
      ],
      "simplifications": "Bounded classic rsyslog selector subset and supplied virtual log destinations. No daemon, host logs, network, timestamps, encoding, includes, RainerScript, rotation or journald. Unsupported syntax is diagnosed. Displayed sample records illustrate replay; grading checks all24 facilities and8 severities.",
      "initial": {
        "kind": "LinuxLogging",
        "simulation": {
          "version": 1,
          "view": "introduction",
          "assignment": {
            "draft": "*.=warning /var/log/operations.log\n",
