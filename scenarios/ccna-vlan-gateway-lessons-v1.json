      ],
      "id": "ccna-switched-gateway-repair",
      "topic": "Switched virtual interfaces and gateways",
      "title": "Restore IPv4 routing between separate VLANs",
      "summary": "Repair the VLAN gateways and restore IPv4 delivery and replies while keeping Ethernet traffic separated.",
      "explanation": "Each subnet has a working gateway, both VLANs can travel across the trunk and the switch routes IP between them. Their Ethernet broadcasts remain separate.",
      "hints": [
        "Check the VLAN interface state and its address plan separately.",
        "A working outbound path can still fail when the server has no valid return gateway.",
        "If the server’s gateway is up but unreachable across the trunk, compare the far uplink and the VLAN ID."
      ],
      "sources": [
        "https://learningcontent.cisco.com/documents/marketing/exam-topics/200-301-CCNA-v1.1.pdf",
        "https://www.cisco.com/c/en/us/td/docs/switches/lan/catalyst9300/software/release/17-7/configuration_guide/int_hw/b_177_int_and_hw_9300_cg/configuring_interface_characteristics.html"
      ],
      "simplifications": "Bounded native edits for two preassigned VLANs, one matched trunk, immediate active-port state, and connected IPv4 route and reply checks. No ARP timing, live STP, physical access, Cisco CLI, VTP, port channels, QoS, dynamic routing or router-on-a-stick.",
      "prerequisites": [
        "ccna-default-access-membership",
        "ccna-ipv4-return-route"
      ],
      "objective": "Enable IPv4 routing and both VLAN gateway interfaces. Use distinct usable gateway addresses with the prefixes shown. Give each of the three stations the default gateway for its VLAN and admit both VLANs at the far uplink. Both studio stations need an IPv4 reply from the render server. Preserve studio Ethernet delivery and keep the server’s broadcasts separate.",
      "retry_guidance": "Read which part of the Ethernet or IPv4 path did not work, then test again.",
      "guide": [
        {
          "title": "Understand the task",
          "why": "An SVI is a switch’s IP interface for one VLAN. Choose a usable address that is not already assigned in that VLAN’s subnet. Enable the interface. Its line state requires an active local port carrying the VLAN.",
          "action": "Verify the supplied path.",
          "commands": []
        },
        {
          "title": "Try the separate example",
          "why": "A local SVI can be up even when the far end of an active trunk does not admit that VLAN. Compare the far uplink’s allowed VLANs with the stations’ access memberships.",
          "action": "Verify the supplied path.",
          "commands": []
        },
        {
          "title": "Complete the independent assignment",
          "why": "Enable IPv4 routing and point each station at the gateway in its own subnet. Test delivery and a reply. The gateway can pass IPv4 traffic between VLANs while Ethernet broadcasts stay within each VLAN.",
          "action": "Verify the supplied path.",
          "commands": []
        }
      ],
