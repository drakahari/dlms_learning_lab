                  "uuid": "00006200-0000-4000-8000-000000000004",
                  "size_bytes": 536870912,
                  "prepared": true,
                  "available": true
                }
              ]
            }
          },
          "configuration": "UUID=00006200-0000-4000-8000-000000000001 /data ext4 defaults 0 2\nUUID=00006200-0000-4000-8000-000000000002 /audit ext4 ro 0 2\nUUID=00006200-0000-4000-8000-000000000003 none swap noauto,pri=30 0 0\nUUID=00006200-0000-4000-8000-000000000004 none swap noauto,pri=5 0 0\n",
          "live": {
            "/data": {
              "volume": "data",
              "read_only": false
            },
            "/audit": {
              "volume": "audit",
              "read_only": true
            }
          },
          "active_swap": {
            "standby": 5
          }
        },
        "example_solution": [
          "storage {\"kind\":\"Save\",\"text\":\"UUID=00006200-0000-4000-8000-000000000001 /data ext4 defaults 0 2\\nUUID=00006200-0000-4000-8000-000000000002 /audit ext4 ro 0 2\\nUUID=00006200-0000-4000-8000-000000000003 none swap auto,pri=30 0 0\\nUUID=00006200-0000-4000-8000-000000000004 none swap noauto,pri=5 0 0\\n\"}",
          "swapon -a"
        ],
        "example_commands": [
