          "configuration": "UUID=00006100-0000-4000-8000-000000000001 /data ext4 defaults 0 2\nUUID=00006100-0000-4000-8000-000000000002 /audit ext4 ro 0 2\nUUID=00006100-0000-4000-8000-000000000003 none swap noauto,pri=40 0 0\nUUID=00006100-0000-4000-8000-000000000004 none swap noauto,pri=5 0 0\n",
          "live": {
