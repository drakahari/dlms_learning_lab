{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "lpic2-mailbox-administration-recovery",
      "version": 1,
      "track": "LPIC-2",
      "unit": "linux-mailbox-administration",
      "topic": "Mailbox administration",
      "title": "Audit a pending change and clean up read notices",
      "summary": "Audit a pending mail-path change, then preview and remove only read expired notices without touching protected mail.",
      "objective": "Keep saved and running per-account mail locations consistent for both rowan and tess; keep the service running and enabled at boot. Keep both accounts' protected IMAP/POP access working and reject unprotected remote passwords. In rowan's INBOX and Archive, permanently remove every read message whose Subject contains [EXPIRED]. Keep unread [EXPIRED] notices unread and unmarked, preserve all other rowan messages, and preserve every tess message.",
      "retry_guidance": "Read the failing outcome and actual command results. Correct the saved/running setting or refine the mailbox/user/query. If protected mail was removed, reset this attempt to restore its supplied messages before retrying.",
      "difficulty": "Advanced",
      "minutes": 40,
      "steps": [
        "Understand the task",
        "Investigate and change the supplied server",
        "Verify current outcomes"
      ],
      "guide": [
        {
          "title": "Inspect, repair and save the pending setting",
          "why": "A running server can be healthy while its saved file would break the next restart. doveconf mail_path prints the saved setting; -h hides the setting name. It does not read unsaved editor text or apply changes. Here only named-setting queries are supported, not full/default dumps.",
          "action": "Run doveconf -h mail_path before editing. Fill worked configuration, then Save configuration and run the query again. Restart service only after the saved value is correct; Enable at boot.",
          "commands": []
        },
        {
          "title": "Preview and apply the same precise query",
          "why": "doveadm works on a server-side mail store. This workspace supplies that administrator role; it does not ask you to run sudo or contact a real server. mailbox list names a supplied user’s folders; search identifies matching messages by mailbox identity and UID. UIDs are not POP positions.",
          "action": "Insert and Run command for mailbox list, then search and fetch for elin/INBOX with seen subject '[DRILL]'. Inspect the UID and Subject before running expunge with that same query. Repeat for Archive.",
          "commands": [
            {
              "command": "doveconf -h mail_path",
              "explanation": "Read the saved mail_path value. It is not the unsaved editor text or a claim about the running process.",
              "simulator_only": false
            },
            {
              "command": "doveconf mail_path ssl",
              "explanation": "Inspect two named saved settings after Save configuration.",
              "simulator_only": false
            },
            {
              "command": "doveadm mailbox list -u elin",
              "explanation": "List folders belonging to the supplied worked account; this is not an IMAP LOGIN.",
              "simulator_only": false
            },
            {
              "command": "doveadm search -u elin mailbox INBOX seen subject '[DRILL]'",
              "explanation": "Preview the intersection of mailbox, read flag and Subject before changing mail.",
              "simulator_only": false
            },
            {
              "command": "doveadm fetch -u elin 'uid flags hdr.subject' mailbox INBOX seen subject '[DRILL]'",
              "explanation": "Inspect matching identifiers and headers without changing the read flag.",
              "simulator_only": false
            },
            {
              "command": "doveadm expunge -u elin mailbox INBOX seen subject '[DRILL]'",
              "explanation": "Remove only this previewed selection immediately; this is a real administration operation within virtual mail.",
              "simulator_only": false
            },
            {
              "command": "doveadm search -u elin mailbox Archive seen subject '[DRILL]'",
              "explanation": "Preview the same conditions in the other supplied folder.",
              "simulator_only": false
            },
            {
              "command": "doveadm expunge -u elin mailbox Archive seen subject '[DRILL]'",
              "explanation": "Apply the verified Archive selection separately.",
              "simulator_only": false
            },
            {
              "command": "doveadm search -u elin mailbox INBOX subject '[DRILL]'",
              "explanation": "A read-only counterexample: dropping seen also selects the unread notice. Inspect this broader result before deciding whether it is safe.",
              "simulator_only": false
            }
          ]
        },
        {
          "title": "Check and try a useful counterexample",
          "why": "Search terms combine with AND. For example, mailbox INBOX seen subject '[DRILL]' selects read notices containing that marker in one mailbox. Quote 'uid flags hdr.subject' so fetch receives one field-list argument. Fetch inspects without marking mail read here. Expunge immediately removes matches; it does not wait for a Deleted flag or QUIT.",
          "action": "Check example. Run the final read-only search without seen on the remaining mail, then run the precise query again. Compare the UIDs before considering any further expunge.",
          "commands": []
        }
      ],
      "explanation": "Inspect the saved mail_path, replace the fixed-user path with a supplied per-account form, save it and keep the running settings consistent. In each rowan folder, preview the conjunction of seen and Subject [EXPIRED], inspect UID/flags/Subject, then expunge that same selection. Individual explicit UID selections derived from inspection are also valid. Preserve the unread notices and all tess mail; admin expunge is not a POP commit.",
      "hints": [
        "Compare doveconf mail_path with the two supplied account locations; one fixed user path cannot serve both.",
        "Preview rowan’s folders with MAILBOX, SEEN and SUBJECT together. A Subject-only query also selects protected unread mail.",
        "Expunge is immediate. Verify each folder and the other account afterward; changing the saved file requires matching running settings and boot enablement."
      ],
      "sources": [
        "https://www.lpi.org/our-certifications/exam-201-202-objectives/",
        "https://doc.dovecot.org/2.4.1/core/man/doveconf.1.html",
        "https://doc.dovecot.org/2.4.1/core/man/doveadm-mailbox.1.html",
        "https://doc.dovecot.org/2.4.1/core/man/doveadm-search.1.html",
        "https://doc.dovecot.org/2.4.1/core/man/doveadm-search-query.7.html",
        "https://doc.dovecot.org/2.4.1/core/man/doveadm-fetch.1.html",
        "https://doc.dovecot.org/2.4.1/core/man/doveadm-expunge.1.html",
        "https://www.courier-mta.org/imap/",
        "https://www.courier-mta.org/authlib/"
      ],
      "simplifications": "Dovecot CE2.4.1-inspired named-setting queries and bounded local mailbox administration; no full/default dumps, filters, sockets, userdb, MIME/date/OR/NOT/wildcard queries, new mailboxes, external daemon or host files. Input is literal command words with quoting, not a full shell. GUID-shaped values are synthetic stable mailbox identities. Courier is awareness, not a simulated implementation. See MAILBOX_ADMIN_SUBSET.md.",
