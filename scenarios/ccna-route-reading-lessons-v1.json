{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "ccna-route-reading-backup",
      "version": 1,
      "track": "CCNA",
      "unit": "ipv4-installed-route-reading",
      "topic": "IPv4 route-table interpretation",
      "title": "Restore a learned route while keeping its backup",
      "summary": "Use the installed IPv4 table to restore the intended OSPF exit and keep a static fallback.",
      "objective": "Use the OSPF exit toward Harbor for both addresses inside the Records service network. Keep the wider site route for the outside address. Keep the local, connected and default entries working. Keep the supplied static backup usable when the service announcement is withdrawn. Use the dotted-decimal mask to inspect the exact service entry.",
      "difficulty": "Intermediate",
      "minutes": 22,
      "steps": [
        "Understand the task",
        "Try the separate example",
        "Complete the independent assignment"
      ],
      "guide": [
        {
          "title": "Understand the task",
          "why": "A routing table lists installed routes. C marks a directly connected network, L a local interface address, S a static route and O an intra-area OSPF route. S* marks the supplied static default. The /length and dotted-decimal mask describe the same size. For example, /26 leaves six zero bits in the mask, so the final mask octet is 192.",
          "action": "Inspect the route decisions for the supplied addresses.",
          "commands": []
        },
        {
          "title": "Try the separate example",
          "why": "For the same exact network and mask, the router prefers the eligible source with the lower administrative distance. The first number in [110/23] is distance. The second is metric. OSPF adds outgoing costs along each path and the destination LAN cost, then offers its best path. Do not compare an OSPF cost directly with a static route's distance.",
          "action": "Inspect the route decisions for the supplied addresses.",
          "commands": []
        },
        {
          "title": "Complete the independent assignment",
          "why": "From the installed rows that contain an address, the longest prefix wins. A /26 can win inside its range while a /24 serves nearby addresses. A higher-distance static route for the same /26 can replace an OSPF row when the announcement is no longer available.",
          "action": "Inspect the route decisions for the supplied addresses.",
          "commands": []
        }
      ],
      "retry_guidance": "Inspect the route code and distance, then compare the cheapest OSPF path and matching prefix.",
      "hints": [
        "For the same prefix, compare administrative distances before looking at OSPF path cost.",
        "Change the local outgoing cost toward Harbor while leaving the fixed downstream costs in place.",
        "Keep the static backup eligible in the withdrawal trial and use the mask to query the exact service row."
      ],
      "explanation": "The cheaper requested OSPF path is installed for the more specific network. The static fallback is still eligible for that network when OSPF withdraws it. Wider and local routes continue serving distinct lookups.",
      "sources": [
        "https://learningcontent.cisco.com/documents/marketing/exam-topics/200-301-CCNA-v1.1.pdf",
        "https://www.cisco.com/c/en/us/support/docs/ip/enhanced-interior-gateway-routing-protocol-eigrp/8651-21.html",
        "https://www.cisco.com/c/en/us/support/docs/ip/border-gateway-routing-protocol-bgp/15986-admin-distance.html",
        "https://www.rfc-editor.org/rfc/rfc2328"
      ],
      "simplifications": "One local IPv4 route table composed from the bounded OSPFv2 P2P and static models. No packet forwarding validation, real IOS, host network or CLI. No redistribution, dynamic timers, DR/BDR, recursive next hops or cross-protocol equal-distance ties.",
      "prerequisites": [
        "ccna-ospf-directed-ecmp"
      ],
