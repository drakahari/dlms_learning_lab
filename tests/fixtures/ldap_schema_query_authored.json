  "version": 1,
  "initial": {
    "id": "lpic2-ldap-schema-consumer",
    "instructions": "Schema: Add one consumer schema with new OIDs below 1.3.6.1.4.1.32473.230; preserve the supplied base definitions and accessPerson inheritance from person. Allow uid, accessTeam and accessState. Team labels: accessTeam ignores letter case and insignificant spaces; distinct labels stay distinct. State codes: accessState preserves letter case, so active differs from Active; text equality still ignores insignificant spaces. Filter: Select entries having team Aster and state active. One matching team value is enough. Exclude other states, other teams and entries missing either criterion. Verification: All supplied rosters, verification after names and user IDs change and required comparison tests must pass. Resolve Undefined results; avoid hardcoding individual names.",
    "schema_name": "consumer",
    "oid_branch": "1.3.6.1.4.1.32473.230",
    "starter_schema": "version: 1\n\ndn: cn=consumer,cn=schema,cn=config\nchangetype: add\nobjectClass: olcSchemaConfig\ncn: consumer\nolcAttributeTypes: (1.3.6.1.4.1.32473.230.1\n  NAME 'accessTeam'\n  EQUALITY caseExactMatch\n  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)\nolcAttributeTypes: (1.3.6.1.4.1.32473.230.2\n  NAME 'accessState'\n  EQUALITY caseIgnoreMatch\n  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15\n  SINGLE-VALUE)\nolcObjectClasses: (1.3.6.1.4.1.32473.230.3\n  NAME 'accessPerson'\n  SUP person STRUCTURAL\n  MAY (uid $ accessTeam $ accessState))\n",
    "starter_filter": "(|(accessTeam=Aster)(accessState=active))",
    "reference_schema": "version: 1\n\ndn: cn=consumer,cn=schema,cn=config\nchangetype: add\nobjectClass: olcSchemaConfig\ncn: consumer\nolcAttributeTypes: (1.3.6.1.4.1.32473.230.1\n  NAME 'accessTeam'\n  EQUALITY caseIgnoreMatch\n  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)\nolcAttributeTypes: (1.3.6.1.4.1.32473.230.2\n  NAME 'accessState'\n  EQUALITY caseExactMatch\n  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15\n  SINGLE-VALUE)\nolcObjectClasses: (1.3.6.1.4.1.32473.230.3\n  NAME 'accessPerson'\n  SUP person STRUCTURAL\n  MAY (uid $ accessTeam $ accessState))\n",
    "reference_filter": "(&(accessTeam=Aster)(accessState=active))",
    "rules": [
