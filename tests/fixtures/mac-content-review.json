  {
    "id": "ccna-mac-source-refresh",
    "alternates": [
      [
        "@mac {\"kind\":\"Aging\",\"seconds\":120}",
        "@mac {\"kind\":\"Send\",\"source\":\"sensor\",\"destination\":\"ff:ff:ff:ff:ff:ff\"}"
      ],
      [
        "@mac {\"kind\":\"Clear\",\"switch\":\"telemetry\",\"vlan\":70}",
        "@mac {\"kind\":\"Aging\",\"seconds\":100}",
        "@mac {\"kind\":\"Send\",\"source\":\"collector\",\"destination\":\"02:00:00:03:00:01\"}",
        "@mac {\"kind\":\"Send\",\"source\":\"sensor\",\"destination\":\"02:00:00:03:00:02\"}"
      ]
    ],
    "partial": [
      "@mac {\"kind\":\"Aging\",\"seconds\":120}"
    ],
    "wrong": [
      {
        "name": "destination_traffic_is_not_refresh",
        "actions": [
          "@mac {\"kind\":\"Aging\",\"seconds\":120}",
          "@mac {\"kind\":\"Send\",\"source\":\"collector\",\"destination\":\"02:00:00:03:00:01\"}"
        ],
        "why": "Sensor’s old row expires inside the future quiet interval."
      },
      {
        "name": "disable_expiry",
        "actions": [
          "@mac {\"kind\":\"Aging\",\"seconds\":0}",
          "@mac {\"kind\":\"Send\",\"source\":\"sensor\",\"destination\":\"02:00:00:03:00:02\"}"
        ],
        "why": "Zero fails the bounded policy and later unknown-destination promise."
      },
      {
        "name": "too_short",
        "actions": [
          "@mac {\"kind\":\"Aging\",\"seconds\":30}",
          "@mac {\"kind\":\"Send\",\"source\":\"sensor\",\"destination\":\"02:00:00:03:00:02\"}",
          "@mac {\"kind\":\"Send\",\"source\":\"collector\",\"destination\":\"02:00:00:03:00:01\"}"
        ],
        "why": "The required sixty-second interval outlasts this lifetime."
      },
      {
        "name": "long_lifetime",
        "actions": [
          "@mac {\"kind\":\"Aging\",\"seconds\":1000}",
          "@mac {\"kind\":\"Send\",\"source\":\"sensor\",\"destination\":\"02:00:00:03:00:02\"}"
        ],
        "why": "The requested upper bound and later expiry are not met."
      }
    ],
