      "accounts_teaching": {
        "prerequisite_note": "Practice after the file and access foundations. This fixture is virtual administrator work only; it creates no host users or credentials.",
        "concepts": [
          {
            "title": "Virtual administrator and stable identities",
            "text": "This terminal changes only supplied in-memory records. UID and GID are numeric identities; adding or renaming a record does not renumber other identities. No passwords, authentication or active sessions are simulated."
          },
          {
            "title": "Create only the supplied group identity",
            "text": "Use groupadd -g GID NAME to create one missing simulated group with its explicit supplied numeric identity. Inspect getent group first. Existing group names or GIDs cannot be replaced by this command; it does not create a user or move existing file ownership."
          },
          {
            "title": "Primary and supplementary membership",
            "text": "A user has one primary GID in its passwd record. Supplementary membership is separate and appears in group member lists. id shows both. A primary group need not list the user in its group member field."
          },
          {
            "title": "Append versus replacement",
            "text": "usermod -aG appends supplementary membership. usermod -G replaces it with the complete supplied list. Inspect standing access first so replacement does not erase a required group."
          },
          {
            "title": "Primary group and retained files",
            "text": "usermod -g changes the primary GID and the old-GID entries inside an owned home, including entries owned by a different UID. It leaves different-GID home entries and files outside that home unchanged."
          }
        ],
        "example": [
          "id tess",
          "usermod -aG sample-review tess",
          "usermod -g sample-review tess"
        ],
        "example_commands": [
          {
            "command": "id tess",
            "explanation": "Inspect the supplied UID, primary group and supplementary groups before changing anything.",
            "simulator_only": false
          },
          {
            "command": "usermod -aG sample-review tess",
            "explanation": "Append sample-review without removing standing sample-audit membership.",
            "simulator_only": false
          },
          {
            "command": "usermod -g sample-review tess",
            "explanation": "Change the primary group. Old-primary-group entries inside the owned home also change group; outside entries stay unchanged.",
            "simulator_only": false
          }
        ],
        "inputs": "Use Tess and Omar, the sample groups and the supplied example date. These identities and files are separate from Mira and Bryn in the assignment. Enter one literal command at a time.",
        "try_change": "After the example, replace Tess supplementary membership with only sample-review. Inspect the lost sample-audit membership, then append sample-audit to repair it.",
