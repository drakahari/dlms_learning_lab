    {
      "id": "lpic2-proxy-connect-order",
      "version": 1,
      "track": "LPIC-2",
      "topic": "Proxy access policy",
      "unit": "linux-proxy-access-policy",
      "title": "Repair a tunnel restriction that runs too late",
      "summary": "Keep ordinary web access working while preventing CONNECT tunnels to unsafe ports.",
      "objective": "Permit staff clients in 10.70.8.0/24 to use non-CONNECT methods on destination ports 80 and 443. Permit CONNECT only for staff clients targeting destination port 443; refuse CONNECT to every other port. Refuse all requests from other source addresses and all requests to other destination ports. Apply the policy to the whole stated ranges, not only the named samples. Save and apply a policy that satisfies these requirements; preserve independent practice work.",
      "retry_guidance": "Inspect the first failing request and its first matching rule. Recheck the address range, method, destination port and rule order; save, apply and check again.",
      "difficulty": "Intermediate",
      "minutes": 30,
      "steps": [
        "Understand the supplied clients, requests and full policy requirements.",
        "Inspect the currently applied decision for a failed request.",
        "Edit squid.conf, save it, check its syntax and apply the saved policy.",
        "Check sample requests plus the full supported request space, then repair any remaining leak."
      ],
      "guide": [],
      "explanation": "Access tests in one rule must all match, and the first matching rule decides. A later tunnel restriction cannot undo an earlier broad permit. Guard the allowed destination ports and unsafe CONNECT requests before allowing the staff subnet. Port permission does not prove TLS or establish a real connection.",
      "hints": [
        "Compare the request that should be refused with the first rule it actually reaches.",
        "A later deny cannot undo an earlier matching allow.",
        "Guard both ordinary destination ports and CONNECT before the general staff permit."
      ],
      "sources": [
        "https://www.lpi.org/our-certifications/exam-201-202-objectives/",
        "https://www.squid-cache.org/Versions/v3/3.5/cfgman/acl.html",
        "https://www.squid-cache.org/Versions/v3/3.5/cfgman/http_access.html",
        "https://wiki.squid-cache.org/SquidFaq/SquidAcl"
      ],
      "simplifications": "Bounded original Squid 3.5-style ACL parser over supplied IPv4/method/port records. src, port, method and http_access only; no live proxy, packets, DNS/domain ACLs, cache, authentication, resource controls, IPv6, regex, Includes, host files/commands or TLS inspection. Saving/applied-policy transitions are explicit simulator rules, not real Squid service acceptance. Internal @proxy-policy actions are authored-source data helpers, not shell or Squid commands.",
      "initial": {
        "kind": "ProxyPolicy",
        "simulation": {
          "version": 1,
          "source": {
            "initial": {
              "version": 1,
              "id": "lpic2-proxy-connect-order",
              "initial_config": "acl staff src 10.70.8.0/24\nacl web port 80 443\nacl secure port 443\nacl tunnels method CONNECT\nhttp_access allow staff web\nhttp_access deny tunnels !secure\nhttp_access deny all\n",
              "required_policy": "acl staff src 10.70.8.0/24\nacl web port 80 443\nacl secure port 443\nacl tunnels method CONNECT\nhttp_access deny !web\nhttp_access deny tunnels !secure\nhttp_access allow staff\nhttp_access deny all\n",
              "cases": [
                {
                  "id": "plain-web",
                  "label": "Staff GET",
                  "request": {
                    "client": "10.70.8.12",
                    "method": "GET",
                    "destination_port": 80
                  },
                  "expected": "allow"
                },
                {
                  "id": "secure-web",
                  "label": "Staff POST",
                  "request": {
                    "client": "10.70.8.12",
                    "method": "POST",
                    "destination_port": 443
                  },
                  "expected": "allow"
