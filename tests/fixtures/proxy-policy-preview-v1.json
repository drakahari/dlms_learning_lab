            "initial_config": "acl staff src 172.22.4.0/24\nacl web port 8080 8443\nacl secure port 8443\nacl tunnels method CONNECT\nhttp_access allow staff web\nhttp_access deny tunnels !secure\nhttp_access deny all\n",
            "required_policy": "acl staff src 172.22.4.0/24\nacl web port 8080 8443\nacl secure port 8443\nacl tunnels method CONNECT\nhttp_access deny !web\nhttp_access deny tunnels !secure\nhttp_access allow staff\nhttp_access deny all\n",
            "cases": [
              {
                "id": "plain-web",
                "label": "Staff GET",
                "request": {
                  "client": "172.22.4.8",
                  "method": "GET",
                  "destination_port": 8080
                },
                "expected": "allow"
              },
              {
                "id": "secure-web",
                "label": "Staff POST",
                "request": {
                  "client": "172.22.4.8",
                  "method": "POST",
                  "destination_port": 8443
                },
                "expected": "allow"
              },
              {
                "id": "secure-tunnel",
                "label": "CONNECT secure",
                "request": {
                  "client": "172.22.4.8",
                  "method": "CONNECT",
                  "destination_port": 8443
                },
                "expected": "allow"
              },
              {
                "id": "unsafe-tunnel",
                "label": "CONNECT plain",
                "request": {
                  "client": "172.22.4.8",
                  "method": "CONNECT",
                  "destination_port": 8080
                },
                "expected": "deny"
              },
              {
                "id": "mail-tunnel",
                "label": "CONNECT mail",
                "request": {
                  "client": "172.22.4.8",
                  "method": "CONNECT",
                  "destination_port": 25
                },
                "expected": "deny"
              },
              {
                "id": "visitor",
                "label": "Visitor GET",
                "request": {
                  "client": "172.22.5.8",
                  "method": "GET",
                  "destination_port": 8080
                },
                "expected": "deny"
              },
              {
                "id": "other-method",
                "label": "Staff OPTIONS",
                "request": {
                  "client": "172.22.4.8",
                  "method": "OPTIONS",
                  "destination_port": 8443
                },
                "expected": "allow"
              }
            ]
          }
        }
      },
      "solution": [
        "@proxy-policy {\"action\":\"edit\",\"config\":\"acl staff src 10.70.8.0/24\\nacl web port 80 443\\nacl secure port 443\\nacl tunnels method CONNECT\\nhttp_access deny !web\\nhttp_access deny tunnels !secure\\nhttp_access allow staff\\nhttp_access deny all\\n\"}",
        "@proxy-policy {\"action\":\"save\"}",
        "@proxy-policy {\"action\":\"validate\"}",
        "@proxy-policy {\"action\":\"apply\"}",
        "@proxy-policy {\"action\":\"check\"}"
      ],
      "prerequisites": [
        "lpic2-proxy-client-boundary"
      ]
    }
  ]
}
