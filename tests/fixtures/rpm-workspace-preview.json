        "prerequisite_note": "Use the supplied virtual archive paths. This separate gallery uses different packages and files from the assignment.",
        "concepts": [
          {
            "title": "A package name and a capability differ",
            "text": "Requires names a capability. Either an actual package name or an explicit versioned Provides can satisfy it. An unversioned provide cannot satisfy a versioned requirement."
          },
          {
            "title": "A record does not prove intact files",
            "text": "File lists come from stored metadata. The read-only inspector compares simulated current content with the recorded payload. This is not rpm -V or signature verification."
          },
          {
            "title": "Only explicit local archives are installed",
            "text": "These script-free noarch exercises have no downloads or resolver. Choose every needed archive. Unsupported operations leave the current state unchanged; a simulator explanation is not an RPM exit status."
          }
        ],
        "example_description": "Install a museum panel and its separate supplier, preserve the museum note, then remove and restore the panel.",
        "example_commands": [
          {
            "command": "rpm -qp --requires /museum/rpms/panel-a.rpm",
            "explanation": "Inspect the declared requirements without installing."
          },
          {
            "command": "rpm -i /museum/rpms/panel-a.rpm /museum/rpms/supply-a.rpm",
            "explanation": "Install the explicit compatible set; no dependency is fetched."
          }
        ],
        "try_change": {
          "description": "Remove the museum panel and inspect its recorded absence while its supplier and the note remain.",
          "commands": [
            {
              "command": "rpm -e museum-panel",
              "explanation": "This removes only the selected package."
            }
          ],
          "expected": [
