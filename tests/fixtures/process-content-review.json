[
  {
    "id": "lpic1-process-pause",
    "alternate": [
      "kill -s SIGSTOP -- 1510"
    ],
    "incorrect": [
      "kill -TERM 1510"
    ],
    "misconception": "Ending a process is not the same as pausing and preserving its instance."
  },
  {
    "id": "lpic1-process-pending",
    "alternate": [
      "kill -9 1610"
    ],
    "incorrect": [
      "kill -TERM 1610"
    ],
    "misconception": "Repeating TERM does not resume a stopped process or deliver its pending ending request."
  },
  {
    "id": "lpic1-process-priority",
    "alternate": [
      "renice +10 1710"
    ],
    "incorrect": [
      "kill -STOP 1710",
      "renice 10 -p 1710"
    ],
    "misconception": "A lower-urgency process must still be active; pausing it is a different action."
  },
  {
    "id": "lpic1-process-handover",
    "alternate": [
      "kill -INT 1810",
      "kill -9 1811",
      "renice 15 1930",
      "kill -s SIGCONT -- 1920"
    ],
    "incorrect": [
      "kill -TERM 1810",
      "kill -CONT 1920",
      "renice 15 -p 1930"
    ],
    "misconception": "Ending only the parent leaves the abandoned worker alive under init."
  }
]
