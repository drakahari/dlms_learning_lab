{
  "schema_version": 1,
  "directories": [
    "/",
    "/work",
    "/out",
    "/empty",
    "/hidden-only",
    "/work/-dir room"
  ],
  "entries": [
    {
      "kind": "regular",
      "path": "/work/original",
      "text": "shared report\n",
      "mode": 0
    },
    {
      "kind": "hard",
      "path": "/work/alias",
      "from": "/work/original"
    },
    {
      "kind": "copy",
      "path": "/work/copy",
      "from": "/work/original"
    },
    {
      "kind": "symbolic",
      "path": "/work/shortcut",
      "target": "original"
    },
    {
      "kind": "symbolic",
      "path": "/work/dangling",
      "target": "missing"
    },
    {
      "kind": "regular",
      "path": "/work/.hidden",
      "text": "hidden report\n",
      "mode": 384
    },
    {
      "kind": "regular",
      "path": "/hidden-only/.only",
      "text": "not listed by default\n",
      "mode": 384
    },
    {
      "kind": "symbolic",
      "path": "/out/portal",
      "target": "../work"
    },
    {
      "kind": "hard",
      "path": "/out/pin",
      "from": "/work/original"
    },
    {
      "kind": "regular",
      "path": "/work/-dir room/-name with space",
      "text": "literal report\n",
      "mode": 384
    }
  ],
  "queries": [
    {
      "id": "default-work",
      "classification": "supported",
      "args": [
        "-i"
      ]
    },
    {
      "id": "directory-symlink",
      "classification": "supported",
      "args": [
        "-i",
        "/out/portal"
      ]
    },
    {
      "id": "hidden-only",
      "classification": "supported",
      "args": [
        "-i",
        "/hidden-only"
      ]
    },
    {
      "id": "empty",
      "classification": "supported",
      "args": [
        "-i",
        "/empty"
      ]
    },
    {
      "id": "literal-directory",
      "classification": "supported",
      "args": [
        "-i",
        "--",
        "-dir room"
      ]
    },
    {
      "id": "link-directory",
      "classification": "supported",
      "args": [
        "-i",
        "/out"
      ]
    },
    {
      "id": "excluded-file",
      "classification": "excluded",
      "args": [
        "-i",
        "/work/original"
      ]
    },
    {
      "id": "excluded-all",
      "classification": "excluded",
      "args": [
        "-i",
        "-a",
        "/work"
      ]
    }
  ]
}
