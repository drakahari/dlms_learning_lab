{
  "schema_version": 1,
  "cases": [
    {
      "id": "login-priority",
      "invocation": {
        "kind": "InteractiveLogin",
        "noprofile": false
      },
      "files": {
        "/etc/profile": {
          "text": "BASE=system\nexport BASE\n"
        },
        "~/.bash_profile": {
          "text": "APP=\"$SOURCE\"\nexport APP\nPRIVATE=local"
        },
        "~/.bash_login": {
          "text": "APP=wrong-login"
        },
        "~/.profile": {
          "text": "APP=wrong-profile"
        },
        "~/.bashrc": {
          "text": "printf wrong"
        }
      },
      "expected_selection": [
        "/etc/profile",
        "~/.bash_profile"
      ],
      "env": {
        "SOURCE": "amber"
      },
      "command": "printf '%s\\n' \"$APP\"",
      "observe": [
        "APP",
        "BASE",
        "PRIVATE"
      ]
    },
    {
      "id": "login-fallback",
      "invocation": {
        "kind": "InteractiveLogin",
        "noprofile": false
      },
      "files": {
        "/etc/profile": {
          "text": "BASE=system\nexport BASE\n"
        },
        "~/.bash_login": {
          "text": "export APP=\"$SOURCE\""
        },
        "~/.profile": {
          "text": "APP=wrong-profile"
        }
      },
      "expected_selection": [
        "/etc/profile",
        "~/.bash_login"
      ],
      "env": {
        "SOURCE": "amber"
      },
      "command": "printf '%s\\n' \"$APP\"",
      "observe": [
        "APP",
        "PRIVATE",
        "SEEN"
      ]
    },
    {
      "id": "profile-fallback",
      "invocation": {
        "kind": "InteractiveLogin",
        "noprofile": false
      },
      "files": {
        "~/.profile": {
          "text": "export APP=\"$SOURCE\""
        }
      },
      "expected_selection": [
        "~/.profile"
      ],
      "env": {
        "SOURCE": "amber"
      },
      "command": "printf '%s\\n' \"$APP\"",
      "observe": [
        "APP",
        "PRIVATE",
        "SEEN"
      ]
    },
    {
      "id": "empty-priority",
      "invocation": {
        "kind": "InteractiveLogin",
        "noprofile": false
      },
      "files": {
        "/etc/profile": {
          "text": "false"
        },
        "~/.bash_profile": {
          "text": ""
        },
        "~/.profile": {
          "text": "printf wrong"
        }
      },
      "expected_selection": [
        "/etc/profile",
        "~/.bash_profile"
      ],
      "env": {
        "SOURCE": "amber"
      },
      "command": "printf '%s\\n' \"$?\"",
      "observe": [
        "APP",
        "PRIVATE",
        "SEEN"
      ]
    },
