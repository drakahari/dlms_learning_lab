    {
      "id": "condition-present",
      "invocation": {
        "kind": "InteractiveNonLogin",
        "norc": false
      },
      "files": {
        "~/.bashrc": {
          "text": "if [ -n \"$SUFFIX\" ]; then APP=\"$SOURCE-$SUFFIX\"; else APP=\"$SOURCE\"; fi\nexport APP"
        }
      },
      "expected_selection": [
        "~/.bashrc"
      ],
      "env": {
        "SOURCE": "copper",
