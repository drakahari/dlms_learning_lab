      "expected_selection": [
        "/etc/profile",
        "~/.bash_profile"
      ],
      "env": {
        "SOURCE": "amber"
      },
      "command": "printf '%s' never",
      "observe": [
        "APP",
        "PRIVATE",
        "SEEN"
      ]
    },
    {
      "id": "quoted-data",
      "invocation": {
        "kind": "InteractiveNonLogin",
        "norc": false
      },
      "files": {
        "~/.bashrc": {
          "text": "APP=\"$SOURCE\"\nexport APP"
        }
      },
      "expected_selection": [
        "~/.bashrc"
      ],
      "env": {
        "SOURCE": "literal $HOME * [x] ; a name with spaces"
      },
      "command": "printf '%s\\n' \"$APP\"",
      "observe": [
        "APP",
        "PRIVATE",
        "SEEN"
      ]
    },
    {
      "id": "opterr-invocation-reset",
      "invocation": {
        "kind": "NonInteractive",
        "bash_env": null
      },
      "files": {},
      "expected_selection": [],
      "env": {
        "OPTERR": "0"
      },
      "command": "printf '%s\\n' \"$OPTERR\"",
      "observe": [
        "APP",
        "PRIVATE",
        "SEEN"
