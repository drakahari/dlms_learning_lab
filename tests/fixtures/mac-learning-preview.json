      "mac_teaching": {
        "prerequisite_note": "This is a separate museum network. A MAC address identifies an Ethernet interface inside this simulation. No operating-system commands or real packets are involved.",
        "concepts": [
          {
            "title": "A frame has a sender and a destination",
            "text": "Choose a supplied sender and type the destination MAC address. Send frame sends one bounded piece of Ethernet metadata, not ping or application data."
          },
          {
            "title": "A switch learns the source",
            "text": "When a frame enters a switch, that switch remembers its source MAC address, local VLAN and incoming port. Receiving a reply teaches the other direction."
          },
          {
            "title": "Unknown destinations can flood",
            "text": "Without a destination entry, a switch copies an individual frame to other eligible ports in that VLAN. Only the intended modeled endpoint accepts it. After learning the destination, forwarding can use one port."
          },
          {
            "title": "Entries age only in virtual time",
            "text": "Advance time expires old source entries. Looking up a destination does not refresh it. The museum example uses a 300-second lifetime; typing does not advance time."
          }
        ],
        "example_description": "Museum sender y uses 02:00:00:00:30:02; sender x uses 02:00:00:00:30:01. Send from y to x, then from x to y. Inspect the learned table and the optional last-frame trace.",
