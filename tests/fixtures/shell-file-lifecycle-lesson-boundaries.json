  "shell-cleanup-preview": [
    {
      "name": "Empty filename",
      "args": [
        "apply",
        ""
      ],
      "stdin": "",
      "env": {},
      "files": {
        "/work/notes.txt": "Keep this unrelated note.\n",
        "/work/cache-old": "old cache\n",
        "/work/cache spare": "spare\n",
        "/work/-cache": "dash cache\n",
        "/work/report.txt": "Protected report\n"
      },
      "stdout": "",
      "stderr": "Unsafe cleanup request\n",
      "status": 2,
      "after": {
        "/work/notes.txt": "Keep this unrelated note.\n",
        "/work/cache-old": "old cache\n",
        "/work/cache spare": "spare\n",
        "/work/-cache": "dash cache\n",
        "/work/report.txt": "Protected report\n"
      }
    },
    {
      "name": "Traversal refused",
      "args": [
        "apply",
        "../cache-old"
