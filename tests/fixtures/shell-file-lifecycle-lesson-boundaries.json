        "/work/notes.txt": "Keep this unrelated note.\n",
        "/work/backup": "restore exact",
        "/work/recovery.000000": "restore exact"
      }
    },
    {
      "name": "Backup name already allocated",
      "args": [
        "deploy",
        "candidate",
        "current",
        "snapshot.000000"
      ],
      "stdin": "",
      "env": {},
      "files": {
        "/work/notes.txt": "Keep this unrelated note.\n",
