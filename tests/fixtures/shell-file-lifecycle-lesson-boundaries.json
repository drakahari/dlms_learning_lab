        "/work/current": "old\n",
        "/work/backup": "older\n"
      },
      "stdout": "",
      "stderr": "Choose three different files\n",
      "status": 2,
      "after": {
        "/work/notes.txt": "Keep this unrelated note.\n",
        "/work/candidate": "approved\nnew\n",
        "/work/current": "old\n",
        "/work/backup": "older\n"
      }
    },
    {
