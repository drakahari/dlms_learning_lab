  "shell-recover-publication": [
    {
      "name": "Header without final newline",
      "args": [
        "deploy",
        "candidate",
        "current",
        "backup"
      ],
      "stdin": "",
      "env": {},
      "files": {
        "/work/notes.txt": "Keep this unrelated note.\n",
        "/work/candidate": "approved",
        "/work/current": "old"
      },
      "stdout": "Deployed: current\n",
      "stderr": "",
      "status": 0,
      "after": {
        "/work/notes.txt": "Keep this unrelated note.\n",
        "/work/candidate": "approved",
        "/work/current": "approved",
        "/work/backup": "old"
      }
    },
    {
      "name": "Empty backup is valid",
      "args": [
        "restore",
        "candidate",
        "current",
        "backup"
      ],
      "stdin": "",
      "env": {},
      "files": {
        "/work/notes.txt": "Keep this unrelated note.\n",
        "/work/current": "bad",
        "/work/backup": ""
      },
      "stdout": "Restored: current\n",
      "stderr": "",
      "status": 0,
      "after": {
        "/work/notes.txt": "Keep this unrelated note.\n",
        "/work/current": "",
        "/work/backup": ""
      }
    },
    {
      "name": "Empty candidate label",
