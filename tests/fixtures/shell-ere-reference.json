      "id": "groups-numbered",
      "vm_source": "'grep' '-En' '^(ERROR|WARN): [0-9]{2}$'",
      "argv": [
        "grep",
        "-En",
        "^(ERROR|WARN): [0-9]{2}$"
      ],
      "stdin": "INFO: 00\nERROR: 42\nWARN: 03\nERROR: nope\n",
      "files": {},
      "expected": {
        "stdout": "2:ERROR: 42\n3:WARN: 03\n",
        "stderr": "",
        "status": 0,
        "files": {}
      },
      "observed": null
    },
