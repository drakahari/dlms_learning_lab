  "vm_only": [
    {
      "id": "recognized-malformed",
      "source": "grep -E '['",
      "reason": "Simulated Syntax ERE stderr wording is deliberately different from GNU diagnostics; test utility status2 and meaningful independent diagnostics, not cross-tool byte equality."
    },
    {
      "id": "unsupported-backref",
      "source": "grep -E '(a)\\1'",
      "reason": "Unsupported ERE grammar is a simulator diagnostic, not a claim GNU rejects backreferences."
    },
    {
      "id": "work-limit",
      "source": "grep -E '^(a?)*z$'",
      "reason": "Simulator-wide bounded work, Stop and instruction accounting are VM guarantees, not GNU limits."
    },
    {
      "id": "quiet-residual-stdin",
      "source": "grep -Eq yes; cat",
      "reason": "The simulator consumes one acquired finite snapshot; GNU buffering/portable residual stdin is not claimed equivalent."
    },
    {
      "id": "missing-file-diagnostic",
      "source": "grep -Eq '' missing",
      "reason": "Both return2, but simulated virtual-file wording is intentionally defined separately from GNU filesystem diagnostics."
    },
    {
      "id": "non-C-selector",
      "source": "LANG=unsupported\ngrep -E '.'",
      "reason": "Simulated scalar selectors are not general environment export; only externally fixed C/POSIX oracle environment is compared."
    }
  ]
