  "scenarios": [
    {
      "id": "lpic1-client-name-investigation",
      "version": 1,
      "track": "LPIC-1",
      "topic": "Client DNS diagnosis",
      "unit": "linux-client-name-investigation",
      "title": "Find why an application gets the wrong address",
      "summary": "Investigate local aliases, DNS search and stopped fallback, then repair the client without copying changing DNS records.",
      "objective": "Remove the stale report and retired old-rescue aliases from the local rescue.office.lab.test record. Keep rescue.office.lab.test and rescue at 192.0.2.55, localhost at 127.0.0.1, and printer.office.lab.test at 192.0.2.60 through files. Let report resolve through the supplied DNS search settings in both samples, including when its address changes. Let assets fall through to the second DNS search site; keep missing.office.lab.test. unresolved.",
      "difficulty": "Intermediate",
      "minutes": 25,
      "prerequisites": [],
      "steps": [
        "Inspect a lookup, repair the local aliases and source actions, then verify both DNS samples."
      ],
      "guide": [],
      "hints": [
        "A successful answer can still be stale. Run getent ahostsv4 report and compare its source trace with the local row.",
        "Keep the rescue names on the local row. Remove only aliases whose ownership or lifetime has changed.",
        "A missing files entry must be allowed to continue to DNS. DNS then applies the fixed search list; it does not search the local file again."
      ],
      "explanation": "Keep the rescue canonical name and rescue alias at the supplied local address, but remove report and old-rescue. Use files before dns with continuation after a local miss. This keeps the required local override while allowing report and assets to follow the supplied search order. The two DNS samples change report\u2019s address, so copying one answer into hosts cannot satisfy the task. Comments, equivalent explicit default actions and a different row order also work.",
      "sources": [
        "https://www.lpi.org/our-certifications/exam-101-102-objectives/",
        "https://man7.org/linux/man-pages/man1/getent.1.html",
        "https://man7.org/linux/man-pages/man5/nsswitch.conf.5.html",
        "https://man7.org/linux/man-pages/man5/resolv.conf.5.html",
        "https://man7.org/linux/man-pages/man5/hosts.5.html"
      ],
      "simplifications": "In-process IPv4 files/DNS source order with search only inside the DNS backend. Fixed supplied resolver excerpt; positive/missing DNS snapshots, one address per name, no CNAME, IPv6, retries, caches or packets. getent ahostsv4 supports one ordinary name or canonical dotted-decimal IPv4 key; stream/datagram/raw result rows and status0/2 are modeled. Other databases, flags, enumeration, multiple keys, legacy numeric forms and systemd-resolved execution refuse. The trace is simulator inspection, not additional getent output. No host filesystem, network or subprocess; not full glibc conformance or full109.4 coverage.",
      "initial": {
        "kind": "ClientNames",
        "simulation": {
          "version": 1,
          "origin": "lpic1-client-name-investigation",
          "view": "introduction",
          "assignment": {
