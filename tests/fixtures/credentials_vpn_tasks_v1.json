                  "compromise_reported": true,
                  "second_proof": "certificate_with_verified_key"
                }
              },
              "expected": "replace_first"
            },
            {
              "name": "Wrong password with a recognized device",
              "input": {
                "kind": "sign_in",
                "supplied": {
                  "current_password_verified": false,
                  "compromise_reported": false,
                  "second_proof": "certificate_with_verified_key"
                }
              },
              "expected": "deny"
            }
          ]
        }
      },
