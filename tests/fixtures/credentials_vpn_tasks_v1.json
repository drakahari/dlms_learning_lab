              },
              "expected": "allow"
            },
            {
              "name": "22 characters \u00b7 listed proposal",
              "input": {
                "kind": "proposal",
                "supplied": {
                  "characters": 22,
                  "listed": true
                }
              },
              "expected": "deny"
            },
            {
              "name": "Certificate with key possession",
              "input": {
                "kind": "sign_in",
                "supplied": {
                  "current_password_verified": true,
                  "compromise_reported": false,
                  "second_proof": "certificate_with_verified_key"
                }
              },
              "expected": "allow"
            },
            {
              "name": "Biometric unlock and key possession",
              "input": {
                "kind": "sign_in",
                "supplied": {
                  "current_password_verified": true,
                  "compromise_reported": false,
                  "second_proof": "biometric_unlocked_verified_key"
                }
              },
              "expected": "allow"
            },
            {
              "name": "Two memorized secrets",
              "input": {
                "kind": "sign_in",
                "supplied": {
                  "current_password_verified": true,
                  "compromise_reported": false,
                  "second_proof": "memorized_code"
                }
              },
              "expected": "deny"
            },
            {
              "name": "Certificate presented without key proof",
              "input": {
                "kind": "sign_in",
                "supplied": {
                  "current_password_verified": true,
                  "compromise_reported": false,
                  "second_proof": "certificate_only"
