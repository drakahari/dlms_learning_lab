          "trials": [
            {
              "name": "16 characters \u00b7 supplied short proposal",
              "input": {
                "kind": "proposal",
                "supplied": {
                  "characters": 16,
                  "listed": false
                }
              },
              "expected": "deny"
            },
            {
              "name": "19 characters \u00b7 new staff phrase",
              "input": {
                "kind": "proposal",
                "supplied": {
                  "characters": 19,
                  "listed": false
