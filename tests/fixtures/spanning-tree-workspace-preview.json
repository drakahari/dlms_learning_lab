        "concepts": [
          {
            "title": "Ideal steady state",
            "text": "This calculation elects one root in each online point-to-point component. It does not send BPDUs or measure convergence."
          },
          {
            "title": "Priorities and paths",
            "text": "Lower composite bridge identity wins. A root port adds its local cost; root and designated ports forward while alternate ports discard in this stable result."
          }
