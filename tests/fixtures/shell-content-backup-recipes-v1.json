      "example_source": "if test \"$#\" -eq 0 || test \"$#\" -gt 8; then\n    printf 'Usage: snapshot FILE...\\n' >&2\n    exit 2\nfi\nif test -f demo.index; then\n    printf 'Existing snapshot index\\n' >&2\n    exit 2\nfi\nnames=()\nfor name in \"$@\"; do\n    case \"$name\" in\n        ''|.|..|*/*|demo.index|saved-*) printf 'Invalid name\\n' >&2; exit 2 ;;\n    esac\n    names=(\"${names[@]}\" \"$name\")\ndone\nseen=()\nfor name in \"${names[@]}\"; do\n    for earlier in \"${seen[@]}\"; do\n        if test \"$name\" = \"$earlier\"; then\n            printf 'Duplicate request\\n' >&2\n            exit 2\n        fi\n    done\n    seen=(\"${seen[@]}\" \"$name\")\ndone\nfor name in \"${names[@]}\"; do\n    if test -f \"$name\"; then :; else\n        printf 'Missing source: %s\\n' \"$name\" >&2\n        exit 2\n    fi\n    if test -f \"saved-$name\"; then\n        printf 'Backup already exists: saved-%s\\n' \"$name\" >&2\n        exit 2\n    fi\ndone\nfor name in \"${names[@]}\"; do\n    cat < \"$name\" > \"saved-$name\"\ndone\nprintf '%s\\n' \"${names[@]}\" > demo.index\nprintf 'Saved: %s files\\n' \"${#names[@]}\"\n",
      "example_case": {
        "name": "Separate snapshot practice with different names and recovery files",
        "args": [
          "oak",
          "fern"
        ],
        "stdin": "",
        "env": {},
        "files": {
          "/work/oak": "leaves\n\n",
          "/work/fern": "tail",
          "/work/practice.note": "Keep this separate example note.\n"
        },
        "stdout": "Saved: 2 files\n",
        "stderr": "",
        "status": 0,
        "after": {
          "/work/oak": "leaves\n\n",
          "/work/fern": "tail",
          "/work/practice.note": "Keep this separate example note.\n",
          "/work/saved-oak": "leaves\n\n",
          "/work/saved-fern": "tail",
          "/work/demo.index": "oak\nfern\n"
        }
      }
    },
    "restore": {
      "source": "if test \"$#\" -ne 0; then\n    printf 'Usage: restore\\n' >&2\n    exit 2\nfi\nif test -f snapshot.index; then :; else\n    printf 'Missing snapshot index\\n' >&2\n    exit 2\nfi\nnames=()\nwhile IFS= read -r name || test -n \"$name\"; do\n    case \"$name\" in\n        ''|.|..|*/*|snapshot.index|copy-*) printf 'Invalid index entry\\n' >&2; exit 2 ;;\n    esac\n    for earlier in \"${names[@]}\"; do\n        if test \"$name\" = \"$earlier\"; then\n            printf 'Duplicate index entry: %s\\n' \"$name\" >&2\n            exit 2\n        fi\n    done\n    if test -f \"copy-$name\"; then :; else\n        printf 'Missing backup: copy-%s\\n' \"$name\" >&2\n        exit 2\n    fi\n    names=(\"${names[@]}\" \"$name\")\n    if test \"${#names[@]}\" -gt 8; then\n        printf 'Too many snapshot entries\\n' >&2\n        exit 2\n    fi\ndone < snapshot.index\nif test \"${#names[@]}\" -eq 0; then\n    printf 'Empty snapshot index\\n' >&2\n    exit 2\nfi\nfor name in \"${names[@]}\"; do\n    cat < \"copy-$name\" > \"$name\"\ndone\nprintf 'Restored: %s files\\n' \"${#names[@]}\"\n",
      "alternate": "if test \"$#\" -ne 0; then\n    printf 'Usage: restore\\n' >&2\n    exit 2\nfi\nif test -f snapshot.index; then :; else\n    printf 'Missing snapshot index\\n' >&2\n    exit 2\nfi\nnames=()\nwhile IFS= read -r name || test -n \"$name\"; do\n    case \"$name\" in\n        ''|.|..|*/*|snapshot.index|copy-*) printf 'Invalid index entry\\n' >&2; exit 2 ;;\n    esac\n    for earlier in \"${names[@]}\"; do\n        if test \"$name\" = \"$earlier\"; then\n            printf 'Duplicate index entry: %s\\n' \"$name\" >&2\n            exit 2\n        fi\n    done\n    if test -f \"copy-$name\"; then :; else\n        printf 'Missing backup: copy-%s\\n' \"$name\" >&2\n        exit 2\n    fi\n    names=(\"${names[@]}\" \"$name\")\n    if test \"${#names[@]}\" -gt 8; then\n        printf 'Too many snapshot entries\\n' >&2\n        exit 2\n    fi\ndone < snapshot.index\nif test \"${#names[@]}\" -eq 0; then\n    printf 'Empty snapshot index\\n' >&2\n    exit 2\nfi\ncount=0\nwhile IFS= read -r name || test -n \"$name\"; do\n    cat < \"copy-$name\" > \"$name\"\n    count=$((count + 1))\ndone < snapshot.index\nprintf 'Restored: %s files\\n' \"$count\"\n",
