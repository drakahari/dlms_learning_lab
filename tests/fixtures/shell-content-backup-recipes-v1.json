      "example_source": "if test \"$#\" -ne 0; then\n    printf 'Usage: restore\\n' >&2\n    exit 2\nfi\nif test -f demo.index; then :; else\n    printf 'Missing snapshot index\\n' >&2\n    exit 2\nfi\nnames=()\nwhile IFS= read -r name || test -n \"$name\"; do\n    case \"$name\" in\n        ''|.|..|*/*|demo.index|saved-*) printf 'Invalid index entry\\n' >&2; exit 2 ;;\n    esac\n    for earlier in \"${names[@]}\"; do\n        if test \"$name\" = \"$earlier\"; then\n            printf 'Duplicate index entry: %s\\n' \"$name\" >&2\n            exit 2\n        fi\n    done\n    if test -f \"saved-$name\"; then :; else\n        printf 'Missing backup: saved-%s\\n' \"$name\" >&2\n        exit 2\n    fi\n    names=(\"${names[@]}\" \"$name\")\n    if test \"${#names[@]}\" -gt 8; then\n        printf 'Too many snapshot entries\\n' >&2\n        exit 2\n    fi\ndone < demo.index\nif test \"${#names[@]}\" -eq 0; then\n    printf 'Empty snapshot index\\n' >&2\n    exit 2\nfi\nfor name in \"${names[@]}\"; do\n    cat < \"saved-$name\" > \"$name\"\ndone\nprintf 'Restored: %s files\\n' \"${#names[@]}\"\n",
      "example_case": {
        "name": "Separate restore practice with different names and recovery files",
