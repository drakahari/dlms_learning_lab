    "snapshot": {
      "source": "if test \"$#\" -eq 0 || test \"$#\" -gt 8; then\n    printf 'Usage: snapshot FILE...\\n' >&2\n    exit 2\nfi\nif test -f snapshot.index; then\n    printf 'Existing snapshot index\\n' >&2\n    exit 2\nfi\nnames=()\nfor name in \"$@\"; do\n    case \"$name\" in\n        ''|.|..|*/*|snapshot.index|copy-*) printf 'Invalid name\\n' >&2; exit 2 ;;\n    esac\n    names=(\"${names[@]}\" \"$name\")\ndone\nseen=()\nfor name in \"${names[@]}\"; do\n    for earlier in \"${seen[@]}\"; do\n        if test \"$name\" = \"$earlier\"; then\n            printf 'Duplicate request\\n' >&2\n            exit 2\n        fi\n    done\n    seen=(\"${seen[@]}\" \"$name\")\ndone\nfor name in \"${names[@]}\"; do\n    if test -f \"$name\"; then :; else\n        printf 'Missing source: %s\\n' \"$name\" >&2\n        exit 2\n    fi\n    if test -f \"copy-$name\"; then\n        printf 'Backup already exists: copy-%s\\n' \"$name\" >&2\n        exit 2\n    fi\ndone\nfor name in \"${names[@]}\"; do\n    cat < \"$name\" > \"copy-$name\"\ndone\nprintf '%s\\n' \"${names[@]}\" > snapshot.index\nprintf 'Saved: %s files\\n' \"${#names[@]}\"\n",
      "alternate": "if test \"$#\" -eq 0 || test \"$#\" -gt 8; then printf 'Usage: snapshot FILE...\\n' >&2; exit 2; fi\nif test -f snapshot.index; then printf 'Existing snapshot index\\n' >&2; exit 2; fi\nfor name in \"$@\"; do\n    case \"$name\" in ''|.|..|*/*|snapshot.index|copy-*) printf 'Invalid name\\n' >&2; exit 2 ;; esac\ndone\nfor name in \"$@\"; do\n    matches=0\n    for other in \"$@\"; do\n        if test \"$other\" = \"$name\"; then matches=$((matches + 1)); fi\n    done\n    if test \"$matches\" -gt 1; then printf 'Duplicate request\\n' >&2; exit 2; fi\ndone\nfor name in \"$@\"; do\n    if test -f \"$name\"; then :; else printf 'Missing source: %s\\n' \"$name\" >&2; exit 2; fi\n    if test -f \"copy-$name\"; then printf 'Backup already exists: copy-%s\\n' \"$name\" >&2; exit 2; fi\ndone\nfor name in \"$@\"; do cat < \"$name\" > \"copy-$name\"; done\nprintf '%s\\n' \"$@\" > snapshot.index\nprintf 'Saved: %s files\\n' \"$#\"\n",
