              "last_day": 100,
              "dns_names": [
                "reports.campus.example"
              ]
            },
            {
              "id": "campus-archive",
              "public_key_id": "campus-archive-pub",
              "issuer": "campus-intermediate",
              "is_ca": false,
              "first_day": 1,
              "last_day": 100,
              "dns_names": [
                "archive.campus.example"
              ]
            },
            {
              "id": "campus-reports-old",
              "public_key_id": "campus-reports-old-pub",
              "issuer": "campus-intermediate",
              "is_ca": false,
              "first_day": 1,
              "last_day": 30,
              "dns_names": [
                "reports.campus.example"
              ]
            }
          ],
          "bundles": [
            {
              "path": "/etc/ssl/campus/reports-leaf.pem",
              "certificate_ids": [
                "campus-reports"
              ]
            },
            {
              "path": "/etc/ssl/campus/reports-full.pem",
              "certificate_ids": [
                "campus-reports",
                "campus-intermediate"
              ]
            },
            {
              "path": "/etc/ssl/campus/reports-with-root.pem",
              "certificate_ids": [
                "campus-reports",
                "campus-intermediate",
                "campus-root"
              ]
            },
            {
              "path": "/etc/ssl/campus/reports-old.pem",
              "certificate_ids": [
                "campus-reports-old",
                "campus-intermediate"
              ]
            },
            {
              "path": "/etc/ssl/campus/archive-full.pem",
              "certificate_ids": [
                "campus-archive",
                "campus-intermediate"
              ]
            }
          ],
          "keys": [
            {
              "path": "/etc/ssl/campus/reports.key",
              "matching_public_key_id": "campus-reports-pub"
            },
            {
              "path": "/etc/ssl/campus/archive.key",
              "matching_public_key_id": "campus-archive-pub"
            },
            {
              "path": "/etc/ssl/campus/reports-old.key",
              "matching_public_key_id": "campus-reports-old-pub"
            }
          ]
        },
        "starter": "# Supplied HTTPS sites\n<VirtualHost *:443>\n    ServerName reports.campus.example\n    SSLEngine on\n    SSLCertificateFile /etc/ssl/campus/reports-leaf.pem\n    SSLCertificateKeyFile /etc/ssl/campus/reports.key\n</VirtualHost>\n\n<VirtualHost *:443>\n    ServerName archive.campus.example\n    SSLEngine on\n    SSLCertificateFile /etc/ssl/campus/archive-full.pem\n    SSLCertificateKeyFile /etc/ssl/campus/archive.key\n</VirtualHost>\n",
        "checks": [
          {
            "label": "Primary HTTPS client",
            "client": {
              "hostname": "reports.campus.example",
              "sni": "reports.campus.example",
              "day": 46,
              "trusted": [
                "campus-root"
              ]
            },
            "site": "reports.campus.example",
            "expected": "verified"
          },
          {
            "label": "Auxiliary HTTPS client",
            "client": {
              "hostname": "archive.campus.example",
              "sni": "archive.campus.example",
              "day": 46,
              "trusted": [
                "campus-root"
              ]
            },
            "site": "archive.campus.example",
            "expected": "verified"
          }
        ]
      },
