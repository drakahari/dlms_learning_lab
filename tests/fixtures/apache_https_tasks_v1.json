          {
            "label": "No SNI uses the primary default",
            "client": {
              "hostname": "unknown.studio.example",
              "sni": null,
              "day": 46,
              "trusted": [
                "studio-root"
              ]
            },
            "site": "catalog.studio.example",
            "expected": "name_mismatch_on_default"
