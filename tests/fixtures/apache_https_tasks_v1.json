              "trusted": [
                "studio-root"
              ]
            },
            "site": "docs.studio.example",
            "expected": "verified"
          },
          {
            "label": "Unknown SNI uses the primary default",
            "client": {
              "hostname": "unknown.studio.example",
              "sni": "unknown.studio.example",
              "day": 46,
              "trusted": [
                "studio-root"
              ]
            },
            "site": "catalog.studio.example",
            "expected": "name_mismatch_on_default"
