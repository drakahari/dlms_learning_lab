    {
      "id": "lpic1-host-mixed-ip",
      "version": 1,
      "track": "LPIC-1",
      "unit": "linux-mixed-ip-foundations",
      "topic": "IPv4 and IPv6 foundations",
      "title": "Repair both families of a Linux connection",
      "summary": "Repair IPv4 and IPv6 address and route decisions while keeping a separate management connection intact.",
      "objective": "Keep ens3 up and give it one unused conventional IPv4 host address in 10.24.0.0/26 and one unused IPv6 primary address in 2001:db8:24::/64. Do not use supplied peer/router addresses or the IPv6 subnet-router anycast address. Select the lowest-metric IPv4 default through 10.24.0.1 on ens3 and the IPv6 default through fe80::1 on ens3. Restore the supplied application paths to 203.0.113.80 and 2001:db8:80::80 through ens3. Preserve ens4’s IPv4 and IPv6 primary settings, both interface Up states, and all supplied management-route entries for 198.51.100.0/24 and 2001:db8:99::/64. Management paths to 198.51.100.10 and 2001:db8:99::10 must still use ens4.",
      "retry_guidance": "Compare the address family and selected outgoing device in the failing path. Repair only that family, then recheck the other application and both management paths.",
      "difficulty": "Intermediate",
      "minutes": 25,
      "prerequisites": [],
      "steps": [
        "Read IPv4 and IPv6 addresses and their separate route tables",
        "Repair both application address/route decisions",
        "Verify both families and preserve management"
      ],
      "guide": [],
