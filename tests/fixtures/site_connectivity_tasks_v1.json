          "to": 2,
          "reachable": true,
          "outage": {
            "kind": "none"
          },
          "retry": "Provide a path from the laptop and gateway to the printer at this site."
        },
        {
          "label": "Laptop reaches hosted service normally",
          "from": 0,
          "to": 6,
          "reachable": true,
          "outage": {
            "kind": "none"
          },
          "retry": "The hosted service sits at a different site. Connect a working carrier path."
        },
        {
          "label": "Local print remains available without the office uplink",
          "from": 0,
          "to": 2,
          "reachable": true,
          "outage": {
            "kind": "link",
            "index": 6
          },
          "retry": "The printer should stay on the office side when the office gateway loses its fixed carrier."
        },
        {
          "label": "Hosted service is reachable without the fixed carrier",
          "from": 0,
          "to": 6,
          "reachable": true,
          "outage": {
            "kind": "node",
            "index": 3
          },
          "retry": "The fixed carrier is unavailable. Use the supplied backup path for the hosted service."
        },
        {
          "label": "Hosted service remains reachable without the backup carrier",
          "from": 0,
          "to": 6,
          "reachable": true,
          "outage": {
            "kind": "node",
            "index": 4
          },
          "retry": "Keep the working fixed carrier path as well as the backup."
        },
        {
          "label": "Visitor cannot use local printing",
          "from": 7,
          "to": 2,
          "reachable": false,
          "outage": {
            "kind": "none"
          },
          "retry": "Keep the visitor off the office links that lead to the printer."
        },
        {
          "label": "Visitor cannot reach the hosted service through the office",
          "from": 7,
          "to": 6,
          "reachable": false,
          "outage": {
            "kind": "none"
          },
          "retry": "The same visitor connection would also offer a path to the hosted service."
        }
      ],
